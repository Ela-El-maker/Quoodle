<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
            <Color x:Key="Color.AppBackground">#FF080B12</Color>
            <Color x:Key="Color.ShellBackground">#FF121621</Color>
            <Color x:Key="Color.PaneBackground">#FF141923</Color>
            <Color x:Key="Color.Surface">#FF171D29</Color>
            <Color x:Key="Color.SurfaceAlt">#FF101521</Color>
            <Color x:Key="Color.Border">#FF273042</Color>

            <Color x:Key="Color.TextPrimary">#FFF2F5FB</Color>
            <Color x:Key="Color.TextSecondary">#FFB4BDCC</Color>
            <Color x:Key="Color.TextMuted">#FF7E889B</Color>

            <Color x:Key="Color.Brand">#FF2EA8FF</Color>
            <Color x:Key="Color.Success">#FF36D483</Color>
            <Color x:Key="Color.Warning">#FFF2B84B</Color>
            <Color x:Key="Color.Danger">#FFF87171</Color>
            <Color x:Key="Color.Info">#FF59C6FF</Color>

            <Color x:Key="Color.NavSelectedBackground">#FF15342A</Color>
            <Color x:Key="Color.NavSelectedBorder">#FF1F9A61</Color>
            <Color x:Key="Color.NavHoverBackground">#FF1A2130</Color>

            <SolidColorBrush x:Key="AppBackgroundBrush" Color="{ThemeResource Color.AppBackground}" />
            <SolidColorBrush x:Key="ShellBackgroundBrush" Color="{ThemeResource Color.ShellBackground}" />
            <SolidColorBrush x:Key="PaneBackgroundBrush" Color="{ThemeResource Color.PaneBackground}" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="{ThemeResource Color.Surface}" />
            <SolidColorBrush x:Key="SurfaceAltBrush" Color="{ThemeResource Color.SurfaceAlt}" />
            <SolidColorBrush x:Key="BorderBrush" Color="{ThemeResource Color.Border}" />

            <SolidColorBrush x:Key="TextPrimaryBrush" Color="{ThemeResource Color.TextPrimary}" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="{ThemeResource Color.TextSecondary}" />
            <SolidColorBrush x:Key="TextMutedBrush" Color="{ThemeResource Color.TextMuted}" />

            <SolidColorBrush x:Key="BrandBrush" Color="{ThemeResource Color.Brand}" />
            <SolidColorBrush x:Key="SuccessBrush" Color="{ThemeResource Color.Success}" />
            <SolidColorBrush x:Key="WarningBrush" Color="{ThemeResource Color.Warning}" />
            <SolidColorBrush x:Key="DangerBrush" Color="{ThemeResource Color.Danger}" />
            <SolidColorBrush x:Key="InfoBrush" Color="{ThemeResource Color.Info}" />
            <SolidColorBrush x:Key="NeutralBrush" Color="{ThemeResource Color.TextMuted}" />

            <SolidColorBrush x:Key="ChipSuccessBackgroundBrush" Color="#1D3A2E" />
            <SolidColorBrush x:Key="ChipWarningBackgroundBrush" Color="#43371D" />
            <SolidColorBrush x:Key="ChipDangerBackgroundBrush" Color="#44252A" />
            <SolidColorBrush x:Key="ChipInfoBackgroundBrush" Color="#1A3142" />
            <SolidColorBrush x:Key="ChipNeutralBackgroundBrush" Color="#2A3040" />
            <SolidColorBrush x:Key="ChipSuccessForegroundBrush" Color="{ThemeResource Color.Success}" />
            <SolidColorBrush x:Key="ChipWarningForegroundBrush" Color="{ThemeResource Color.Warning}" />
            <SolidColorBrush x:Key="ChipDangerForegroundBrush" Color="{ThemeResource Color.Danger}" />
            <SolidColorBrush x:Key="ChipInfoForegroundBrush" Color="{ThemeResource Color.Info}" />
            <SolidColorBrush x:Key="ChipNeutralForegroundBrush" Color="{ThemeResource Color.TextSecondary}" />

            <SolidColorBrush x:Key="NavSelectedBackgroundBrush" Color="{ThemeResource Color.NavSelectedBackground}" />
            <SolidColorBrush x:Key="NavSelectedBorderBrush" Color="{ThemeResource Color.NavSelectedBorder}" />
            <SolidColorBrush x:Key="NavHoverBackgroundBrush" Color="{ThemeResource Color.NavHoverBackground}" />
            <SolidColorBrush x:Key="HeaderPanelBackgroundBrush" Color="#140E2A1E" />
            <SolidColorBrush x:Key="HeaderPanelBorderBrush" Color="#2B1F9A61" />
            <SolidColorBrush x:Key="WarningPanelBackgroundBrush" Color="#191F1707" />
            <SolidColorBrush x:Key="WarningPanelBorderBrush" Color="#5A7A5A12" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Light">
            <Color x:Key="Color.AppBackground">#FFF2F5FA</Color>
            <Color x:Key="Color.ShellBackground">#FFE9EEF5</Color>
            <Color x:Key="Color.PaneBackground">#FFE5EBF3</Color>
            <Color x:Key="Color.Surface">#FFFFFFFF</Color>
            <Color x:Key="Color.SurfaceAlt">#FFF6F8FC</Color>
            <Color x:Key="Color.Border">#FFD6DEEB</Color>

            <Color x:Key="Color.TextPrimary">#FF101828</Color>
            <Color x:Key="Color.TextSecondary">#FF344054</Color>
            <Color x:Key="Color.TextMuted">#FF667085</Color>

            <Color x:Key="Color.Brand">#FF1677D8</Color>
            <Color x:Key="Color.Success">#FF15803D</Color>
            <Color x:Key="Color.Warning">#FFB45309</Color>
            <Color x:Key="Color.Danger">#FFB42318</Color>
            <Color x:Key="Color.Info">#FF0E7490</Color>

            <Color x:Key="Color.NavSelectedBackground">#FFE4F4EA</Color>
            <Color x:Key="Color.NavSelectedBorder">#FF2F9F66</Color>
            <Color x:Key="Color.NavHoverBackground">#FFF0F4FA</Color>

            <SolidColorBrush x:Key="AppBackgroundBrush" Color="{ThemeResource Color.AppBackground}" />
            <SolidColorBrush x:Key="ShellBackgroundBrush" Color="{ThemeResource Color.ShellBackground}" />
            <SolidColorBrush x:Key="PaneBackgroundBrush" Color="{ThemeResource Color.PaneBackground}" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="{ThemeResource Color.Surface}" />
            <SolidColorBrush x:Key="SurfaceAltBrush" Color="{ThemeResource Color.SurfaceAlt}" />
            <SolidColorBrush x:Key="BorderBrush" Color="{ThemeResource Color.Border}" />

            <SolidColorBrush x:Key="TextPrimaryBrush" Color="{ThemeResource Color.TextPrimary}" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="{ThemeResource Color.TextSecondary}" />
            <SolidColorBrush x:Key="TextMutedBrush" Color="{ThemeResource Color.TextMuted}" />

            <SolidColorBrush x:Key="BrandBrush" Color="{ThemeResource Color.Brand}" />
            <SolidColorBrush x:Key="SuccessBrush" Color="{ThemeResource Color.Success}" />
            <SolidColorBrush x:Key="WarningBrush" Color="{ThemeResource Color.Warning}" />
            <SolidColorBrush x:Key="DangerBrush" Color="{ThemeResource Color.Danger}" />
            <SolidColorBrush x:Key="InfoBrush" Color="{ThemeResource Color.Info}" />
            <SolidColorBrush x:Key="NeutralBrush" Color="{ThemeResource Color.TextMuted}" />

            <SolidColorBrush x:Key="ChipSuccessBackgroundBrush" Color="#E6F6EC" />
            <SolidColorBrush x:Key="ChipWarningBackgroundBrush" Color="#FFF4E5" />
            <SolidColorBrush x:Key="ChipDangerBackgroundBrush" Color="#FDEBEC" />
            <SolidColorBrush x:Key="ChipInfoBackgroundBrush" Color="#E8F5FB" />
            <SolidColorBrush x:Key="ChipNeutralBackgroundBrush" Color="#EEF2F7" />
            <SolidColorBrush x:Key="ChipSuccessForegroundBrush" Color="{ThemeResource Color.Success}" />
            <SolidColorBrush x:Key="ChipWarningForegroundBrush" Color="{ThemeResource Color.Warning}" />
            <SolidColorBrush x:Key="ChipDangerForegroundBrush" Color="{ThemeResource Color.Danger}" />
            <SolidColorBrush x:Key="ChipInfoForegroundBrush" Color="{ThemeResource Color.Info}" />
            <SolidColorBrush x:Key="ChipNeutralForegroundBrush" Color="{ThemeResource Color.TextSecondary}" />

            <SolidColorBrush x:Key="NavSelectedBackgroundBrush" Color="{ThemeResource Color.NavSelectedBackground}" />
            <SolidColorBrush x:Key="NavSelectedBorderBrush" Color="{ThemeResource Color.NavSelectedBorder}" />
            <SolidColorBrush x:Key="NavHoverBackgroundBrush" Color="{ThemeResource Color.NavHoverBackground}" />
            <SolidColorBrush x:Key="HeaderPanelBackgroundBrush" Color="#FFF2FAF5" />
            <SolidColorBrush x:Key="HeaderPanelBorderBrush" Color="#FFB7E0C7" />
            <SolidColorBrush x:Key="WarningPanelBackgroundBrush" Color="#FFFFF8EA" />
            <SolidColorBrush x:Key="WarningPanelBorderBrush" Color="#FFEBCB71" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <x:Double x:Key="Spacing.XS">6</x:Double>
    <x:Double x:Key="Spacing.SM">10</x:Double>
    <x:Double x:Key="Spacing.MD">16</x:Double>
    <x:Double x:Key="Spacing.LG">24</x:Double>
    <x:Double x:Key="Spacing.XL">32</x:Double>

    <CornerRadius x:Key="Corner.Small">8</CornerRadius>
    <CornerRadius x:Key="Corner.Medium">12</CornerRadius>
    <CornerRadius x:Key="Corner.Large">18</CornerRadius>

    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="Segoe UI" />
    </Style>

    <Style x:Key="PageTitleTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
        <Setter Property="FontSize" Value="32" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="SectionTitleTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="PageSubtitleTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
        <Setter Property="FontSize" Value="15" />
    </Style>

    <Style x:Key="MutedTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource TextMutedBrush}" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style x:Key="CardBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{ThemeResource Corner.Large}" />
        <Setter Property="Padding" Value="18" />
    </Style>

    <Style x:Key="AccentButtonStyle" TargetType="Button">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Background" Value="{ThemeResource SuccessBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="SecondaryButtonStyle" TargetType="Button">
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
        <Setter Property="Background" Value="{ThemeResource SurfaceAltBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="CornerRadius" Value="10" />
    </Style>

    <Style x:Key="NavSectionTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource TextMutedBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="12,16,0,6" />
    </Style>

    <Style TargetType="NavigationViewItem">
        <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
    </Style>

    <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="Transparent" />
    <SolidColorBrush x:Key="NavigationViewItemForeground" Color="{ThemeResource Color.TextSecondary}" />
    <SolidColorBrush x:Key="NavigationViewItemForegroundSelected" Color="{ThemeResource Color.Success}" />
    <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="{ThemeResource Color.NavSelectedBackground}" />
    <SolidColorBrush x:Key="NavigationViewItemBackgroundPointerOver" Color="{ThemeResource Color.NavHoverBackground}" />
    <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="{ThemeResource Color.NavSelectedBorder}" />
</ResourceDictionary>

<Page
    x:Class="Quoodle.Agent.UiCompanion.Views.DeviceDetailsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:Quoodle.Agent.UiCompanion.Controls"
    xmlns:models="using:Quoodle.Agent.UiCompanion.Models"
    mc:Ignorable="d"
    Background="{ThemeResource AppBackgroundBrush}">

    <ScrollViewer>
        <Grid x:Name="DeviceDetailsRootGrid" Padding="16" MaxWidth="1220">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup>
                    <VisualState x:Name="DeviceDetailsNarrowState">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="0" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="HeroCol2.Width" Value="0" />
                            <Setter Target="HeroCol3.Width" Value="0" />
                            <Setter Target="HealthCard.(Grid.Row)" Value="1" />
                            <Setter Target="HealthCard.(Grid.Column)" Value="0" />
                            <Setter Target="SyncCard.(Grid.Row)" Value="1" />
                            <Setter Target="SyncCard.(Grid.Column)" Value="1" />
                            <Setter Target="FactsCol1.Width" Value="0" />
                            <Setter Target="RuntimePanel.(Grid.Row)" Value="1" />
                            <Setter Target="RuntimePanel.(Grid.Column)" Value="0" />
                            <Setter Target="NetworkPanel.(Grid.Row)" Value="2" />
                            <Setter Target="NetworkPanel.(Grid.Column)" Value="0" />
                            <Setter Target="SyncFactsPanel.(Grid.Row)" Value="3" />
                            <Setter Target="SyncFactsPanel.(Grid.Column)" Value="0" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="DeviceDetailsWideState">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="1200" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="HeroCol2.Width" Value="*" />
                            <Setter Target="HeroCol3.Width" Value="*" />
                            <Setter Target="HealthCard.(Grid.Row)" Value="0" />
                            <Setter Target="HealthCard.(Grid.Column)" Value="2" />
                            <Setter Target="SyncCard.(Grid.Row)" Value="0" />
                            <Setter Target="SyncCard.(Grid.Column)" Value="3" />
                            <Setter Target="FactsCol1.Width" Value="*" />
                            <Setter Target="RuntimePanel.(Grid.Row)" Value="0" />
                            <Setter Target="RuntimePanel.(Grid.Column)" Value="1" />
                            <Setter Target="NetworkPanel.(Grid.Row)" Value="1" />
                            <Setter Target="NetworkPanel.(Grid.Column)" Value="0" />
                            <Setter Target="SyncFactsPanel.(Grid.Row)" Value="1" />
                            <Setter Target="SyncFactsPanel.(Grid.Column)" Value="1" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <StackPanel Spacing="18">
                <StackPanel Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <TextBlock Text="Device Details" Style="{StaticResource PageTitleTextStyle}" />
                        <controls:StatusChip x:Name="ConnectionChip" />
                        <controls:StatusChip x:Name="HealthChip" />
                    </StackPanel>
                    <TextBlock Text="Identity, runtime, network, and sync facts projected from the shared mock snapshot." Style="{StaticResource PageSubtitleTextStyle}" />
                    <TextBlock x:Name="SummaryText" Style="{StaticResource MutedTextStyle}" />
                </StackPanel>

                <Border Style="{StaticResource CardBorderStyle}">
                    <Grid ColumnSpacing="16" RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.4*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition x:Name="HeroCol2" Width="*" />
                            <ColumnDefinition x:Name="HeroCol3" Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Spacing="6">
                            <TextBlock Text="Identity Summary" Style="{StaticResource MutedTextStyle}" />
                            <TextBlock x:Name="HeroDeviceText" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock x:Name="HeroStatusText" Style="{StaticResource PageSubtitleTextStyle}" TextWrapping="Wrap" />
                        </StackPanel>

                        <controls:MetricCard
                            x:Name="ConnectionCard"
                            Grid.Row="0"
                            Grid.Column="1"
                            Tone="Success"
                            Glyph="&#xE701;" />

                        <controls:MetricCard
                            x:Name="HealthCard"
                            Grid.Row="0"
                            Grid.Column="2"
                            Tone="Info"
                            Glyph="&#xE9D9;" />

                        <controls:MetricCard
                            x:Name="SyncCard"
                            Grid.Row="0"
                            Grid.Column="3"
                            Tone="Warning"
                            Glyph="&#xE823;" />
                    </Grid>
                </Border>

                <Grid ColumnSpacing="14" RowSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition x:Name="FactsCol1" Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border x:Name="IdentityPanel" Grid.Row="0" Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Identity" Style="{StaticResource SectionTitleTextStyle}" />
                            <ItemsControl x:Name="IdentityFactsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:DeviceFact">
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Bind Label}" Style="{StaticResource MutedTextStyle}" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind Value}" TextWrapping="Wrap" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border x:Name="RuntimePanel" Grid.Row="0" Grid.Column="1" Style="{StaticResource CardBorderStyle}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Runtime" Style="{StaticResource SectionTitleTextStyle}" />
                            <ItemsControl x:Name="RuntimeFactsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:DeviceFact">
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Bind Label}" Style="{StaticResource MutedTextStyle}" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind Value}" TextWrapping="Wrap" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border x:Name="NetworkPanel" Grid.Row="1" Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Network" Style="{StaticResource SectionTitleTextStyle}" />
                            <ItemsControl x:Name="NetworkFactsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:DeviceFact">
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Bind Label}" Style="{StaticResource MutedTextStyle}" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind Value}" TextWrapping="Wrap" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border x:Name="SyncFactsPanel" Grid.Row="1" Grid.Column="1" Style="{StaticResource CardBorderStyle}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Sync / Health" Style="{StaticResource SectionTitleTextStyle}" />
                            <ItemsControl x:Name="SyncFactsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:DeviceFact">
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Bind Label}" Style="{StaticResource MutedTextStyle}" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind Value}" TextWrapping="Wrap" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>


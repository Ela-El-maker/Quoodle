<Page
    x:Class="Quoodle.Agent.UiCompanion.Views.PairingRecoveryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:Quoodle.Agent.UiCompanion.Controls"
    mc:Ignorable="d"
    Background="{ThemeResource AppBackgroundBrush}">

    <ScrollViewer>
        <Grid x:Name="RecoveryRootGrid" Padding="16" MaxWidth="1180">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup>
                    <VisualState x:Name="RecoveryNarrowState">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="0" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="RecoverySecondaryColumn.Width" Value="0" />
                            <Setter Target="RecoveryRightPanel.Visibility" Value="Collapsed" />
                            <Setter Target="RecoveryActionsPanel.Orientation" Value="Vertical" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="RecoveryWideState">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="1200" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="RecoverySecondaryColumn.Width" Value="*" />
                            <Setter Target="RecoveryRightPanel.Visibility" Value="Visible" />
                            <Setter Target="RecoveryActionsPanel.Orientation" Value="Horizontal" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <StackPanel Spacing="18">
                <StackPanel Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <TextBlock Text="Pairing Recovery" Style="{StaticResource PageTitleTextStyle}" />
                        <controls:StatusChip x:Name="PairStateChip" />
                        <controls:StatusChip x:Name="ConnectionChip" />
                    </StackPanel>
                    <TextBlock Text="Restore connectivity, re-enter onboarding, or reset the local projection state without touching privileged service execution." Style="{StaticResource PageSubtitleTextStyle}" />
                </StackPanel>

                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.5*" />
                        <ColumnDefinition x:Name="RecoverySecondaryColumn" Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Recovery Console" Style="{StaticResource SectionTitleTextStyle}" />
                            <TextBlock x:Name="IdentityText" FontWeight="SemiBold" FontSize="17" />
                            <TextBlock x:Name="HealthText" Style="{StaticResource PageSubtitleTextStyle}" />
                            <TextBlock x:Name="ActivityText" TextWrapping="Wrap" Style="{StaticResource PageSubtitleTextStyle}" />

                            <TextBlock Text="Latest failure context" Style="{StaticResource MutedTextStyle}" Margin="0,10,0,0" />
                            <Border Background="{ThemeResource SurfaceAltBrush}" CornerRadius="{ThemeResource Corner.Medium}" Padding="14" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1">
                                <TextBlock x:Name="FailureContextText" TextWrapping="Wrap" />
                            </Border>

                            <StackPanel x:Name="RecoveryActionsPanel" Orientation="Horizontal" Spacing="10" Margin="0,8,0,0">
                                <Button x:Name="RetryButton" Content="Retry Connection" Click="OnRetryConnection" Style="{StaticResource AccentButtonStyle}" />
                                <Button x:Name="RePairButton" Content="Start Re-pair" Click="OnRePair" Style="{StaticResource SecondaryButtonStyle}" />
                                <Button x:Name="ResetSessionButton" Content="Reset UI Session" Click="OnResetSession" Style="{StaticResource SecondaryButtonStyle}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <StackPanel x:Name="RecoveryRightPanel" Grid.Column="1" Spacing="16">
                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Recommended Order" Style="{StaticResource SectionTitleTextStyle}" />
                                <TextBlock Text="1. Retry the live connection." />
                                <TextBlock Text="2. Start re-pair if transport or auth state looks stale." />
                                <TextBlock Text="3. Reset the UI session only if the mock projection itself is inconsistent." />
                            </StackPanel>
                        </Border>

                        <Border Background="{ThemeResource ChipWarningBackgroundBrush}" CornerRadius="{ThemeResource Corner.Large}" Padding="16">
                            <StackPanel Spacing="6">
                                <TextBlock Text="No privileged recovery path here" Foreground="{ThemeResource ChipWarningForegroundBrush}" FontWeight="SemiBold" />
                                <TextBlock Text="The UI can guide recovery, but the background service remains the authority for transport, pairing, and future Ring0 operations." TextWrapping="Wrap" Style="{StaticResource PageSubtitleTextStyle}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>


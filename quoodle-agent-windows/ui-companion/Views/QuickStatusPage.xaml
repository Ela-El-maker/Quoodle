<Page
    x:Class="Quoodle.Agent.UiCompanion.Views.QuickStatusPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:Quoodle.Agent.UiCompanion.Controls"
    mc:Ignorable="d"
    Background="{ThemeResource AppBackgroundBrush}">

    <Page.Resources>
        <Style x:Key="QuickHeadingStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="52" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="QuickSubtitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="16" />
        </Style>

        <Style x:Key="QuickSectionLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextMutedBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="CharacterSpacing" Value="80" />
        </Style>

        <Style x:Key="QuickIdentityValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="QuickActionPrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#133726" />
            <Setter Property="BorderBrush" Value="#1A6D49" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="Foreground" Value="{ThemeResource SuccessBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Padding" Value="22,12" />
            <Setter Property="MinWidth" Value="240" />
        </Style>

        <Style x:Key="QuickActionInfoButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#09243A" />
            <Setter Property="BorderBrush" Value="#14547F" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="Foreground" Value="{ThemeResource InfoBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Padding" Value="22,12" />
            <Setter Property="MinWidth" Value="170" />
        </Style>

        <Style x:Key="QuickActionNeutralButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2B2F39" />
            <Setter Property="BorderBrush" Value="#3A4253" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Padding" Value="22,12" />
            <Setter Property="MinWidth" Value="190" />
        </Style>
    </Page.Resources>

    <ScrollViewer>
        <Grid Padding="18,8,18,18" MaxWidth="1260">
            <StackPanel Spacing="16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Quick Status" Style="{StaticResource QuickHeadingStyle}" />
                        <TextBlock Text="Live snapshot of agent health and activity." Style="{StaticResource QuickSubtitleStyle}" />
                    </StackPanel>

                    <Border
                        x:Name="ConnectionPill"
                        Grid.Column="1"
                        CornerRadius="18"
                        Padding="16,8"
                        BorderBrush="{ThemeResource HeaderPanelBorderBrush}"
                        BorderThickness="1"
                        Background="#110E2A1E"
                        VerticalAlignment="Top">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Ellipse x:Name="ConnectionPillDot" Width="10" Height="10" Fill="{ThemeResource SuccessBrush}" />
                            <FontIcon x:Name="ConnectionPillIcon" Glyph="&#xE73E;" Foreground="{ThemeResource SuccessBrush}" FontSize="13" />
                            <TextBlock x:Name="ConnectionPillText" Foreground="{ThemeResource SuccessBrush}" FontSize="15" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Style="{StaticResource CardBorderStyle}" Padding="24,18">
                    <Grid ColumnSpacing="18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.25*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="DEVICE NAME" Style="{StaticResource QuickSectionLabelStyle}" />
                            <TextBlock x:Name="DeviceNameText" Style="{StaticResource QuickIdentityValueStyle}" FontSize="33" TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="DEVICE ID" Style="{StaticResource QuickSectionLabelStyle}" />
                            <TextBlock x:Name="DeviceIdText" Style="{StaticResource QuickIdentityValueStyle}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Spacing="4">
                            <TextBlock Text="AGENT VERSION" Style="{StaticResource QuickSectionLabelStyle}" />
                            <TextBlock x:Name="AgentVersionText" Style="{StaticResource QuickIdentityValueStyle}" />
                        </StackPanel>

                        <StackPanel Grid.Column="3" Spacing="4">
                            <TextBlock Text="UPTIME" Style="{StaticResource QuickSectionLabelStyle}" />
                            <TextBlock x:Name="UptimeText" Style="{StaticResource QuickIdentityValueStyle}" />
                        </StackPanel>

                        <StackPanel Grid.Column="4" Spacing="4">
                            <TextBlock Text="POLICY HASH" Style="{StaticResource QuickSectionLabelStyle}" />
                            <TextBlock x:Name="PolicyHashText" Style="{StaticResource QuickIdentityValueStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <controls:MetricCard x:Name="LastSyncCard" Grid.Column="0" Tone="Info" Glyph="&#xE823;" />
                    <controls:MetricCard x:Name="CpuCard" Grid.Column="1" Tone="Success" Glyph="&#xE7F4;" />
                    <controls:MetricCard x:Name="MemoryCard" Grid.Column="2" Tone="Info" Glyph="&#xE950;" />
                    <controls:MetricCard x:Name="EventsCard" Grid.Column="3" Tone="Warning" Glyph="&#xE7BA;" />
                </Grid>

                <Border Style="{StaticResource CardBorderStyle}" Padding="24,18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE945;" Foreground="{ThemeResource SuccessBrush}" />
                                <TextBlock Text="CURRENT ACTIVITY" Style="{StaticResource QuickSectionLabelStyle}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock x:Name="ActivityText" FontSize="38" FontWeight="SemiBold" />
                            <TextBlock x:Name="ActivityDetailsText" Style="{StaticResource QuickSubtitleStyle}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="7" VerticalAlignment="Top">
                            <Ellipse Width="9" Height="9" Fill="{ThemeResource SuccessBrush}" Margin="0,6,0,0" />
                            <TextBlock Text="Live" Foreground="{ThemeResource SuccessBrush}" VerticalAlignment="Top" FontWeight="SemiBold" FontSize="17" />
                        </StackPanel>
                    </Grid>
                </Border>

                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button Click="OnOpenDashboard" Style="{StaticResource QuickActionPrimaryButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xECA5;" FontSize="16" />
                            <TextBlock Text="Open Dashboard" FontSize="16" FontWeight="SemiBold" />
                            <FontIcon Glyph="&#xE72A;" FontSize="13" />
                        </StackPanel>
                    </Button>
                    <Button Click="OnSyncNow" Style="{StaticResource QuickActionInfoButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE117;" FontSize="16" />
                            <TextBlock Text="Sync Now" FontSize="16" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                    <Button Click="OnViewLogs" Style="{StaticResource QuickActionNeutralButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE9D2;" FontSize="16" />
                            <TextBlock Text="View Logs" FontSize="16" FontWeight="SemiBold" />
                            <FontIcon Glyph="&#xE72A;" FontSize="13" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Border
                    x:Name="WarningPanel"
                    Background="{ThemeResource WarningPanelBackgroundBrush}"
                    BorderBrush="{ThemeResource WarningPanelBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="16">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <FontIcon
                            Glyph="&#xE7BA;"
                            Foreground="{ThemeResource ChipWarningForegroundBrush}"
                            FontSize="20"
                            Margin="4,2,0,0" />

                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock x:Name="WarningTitleText" Foreground="{ThemeResource ChipWarningForegroundBrush}" FontWeight="SemiBold" />
                            <TextBlock
                                x:Name="WarningDetailsText"
                                Foreground="{ThemeResource ChipWarningForegroundBrush}"
                                FontSize="15"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <TextBlock
                            x:Name="WarningReviewText"
                            Grid.Column="2"
                            Text="Review ->"
                            Foreground="{ThemeResource ChipWarningForegroundBrush}"
                            FontSize="16"
                            FontWeight="SemiBold"
                            VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>

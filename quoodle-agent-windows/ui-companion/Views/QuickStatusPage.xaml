<Page
    x:Class="Quoodle.Agent.UiCompanion.Views.QuickStatusPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:Quoodle.Agent.UiCompanion.Controls"
    mc:Ignorable="d"
    Background="{ThemeResource AppBackgroundBrush}">

    <Page.Resources>
        <Style x:Key="QuickHeadingStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="32" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="QuickSubtitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="14" />
        </Style>

        <Style x:Key="QuickSectionLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextMutedBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="CharacterSpacing" Value="80" />
        </Style>

        <Style x:Key="QuickIdentityValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="QuickActionPrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{ThemeResource ChipSuccessBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource SuccessBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="MinWidth" Value="160" />
        </Style>

        <Style x:Key="QuickActionInfoButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{ThemeResource ChipInfoBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource InfoBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="Foreground" Value="{ThemeResource InfoBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="MinWidth" Value="140" />
        </Style>

        <Style x:Key="QuickActionNeutralButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{ThemeResource SurfaceAltBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="MinWidth" Value="140" />
        </Style>
    </Page.Resources>

    <ScrollViewer>
        <Grid x:Name="QuickRootGrid" Padding="16,8,16,16" MaxWidth="1220">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup>
                    <VisualState x:Name="QuickNarrowState">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="0" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="HeaderCol1.Width" Value="0" />
                            <Setter Target="ConnectionPill.(Grid.Row)" Value="1" />
                            <Setter Target="ConnectionPill.(Grid.Column)" Value="0" />
                            <Setter Target="ConnectionPill.Margin" Value="0,8,0,0" />
                            <Setter Target="MetricCol2.Width" Value="0" />
                            <Setter Target="MetricCol3.Width" Value="0" />
                            <Setter Target="MemoryCard.(Grid.Row)" Value="1" />
                            <Setter Target="MemoryCard.(Grid.Column)" Value="0" />
                            <Setter Target="EventsCard.(Grid.Row)" Value="1" />
                            <Setter Target="EventsCard.(Grid.Column)" Value="1" />
                            <Setter Target="ActionButtonsPanel.Orientation" Value="Vertical" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="QuickMediumState">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="641" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="HeaderCol1.Width" Value="Auto" />
                            <Setter Target="ConnectionPill.(Grid.Row)" Value="0" />
                            <Setter Target="ConnectionPill.(Grid.Column)" Value="1" />
                            <Setter Target="ConnectionPill.Margin" Value="0" />
                            <Setter Target="MetricCol2.Width" Value="0" />
                            <Setter Target="MetricCol3.Width" Value="0" />
                            <Setter Target="MemoryCard.(Grid.Row)" Value="1" />
                            <Setter Target="MemoryCard.(Grid.Column)" Value="0" />
                            <Setter Target="EventsCard.(Grid.Row)" Value="1" />
                            <Setter Target="EventsCard.(Grid.Column)" Value="1" />
                            <Setter Target="ActionButtonsPanel.Orientation" Value="Horizontal" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="QuickWideState">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="1200" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="HeaderCol1.Width" Value="Auto" />
                            <Setter Target="ConnectionPill.(Grid.Row)" Value="0" />
                            <Setter Target="ConnectionPill.(Grid.Column)" Value="1" />
                            <Setter Target="ConnectionPill.Margin" Value="0" />
                            <Setter Target="MetricCol2.Width" Value="*" />
                            <Setter Target="MetricCol3.Width" Value="*" />
                            <Setter Target="MemoryCard.(Grid.Row)" Value="0" />
                            <Setter Target="MemoryCard.(Grid.Column)" Value="2" />
                            <Setter Target="EventsCard.(Grid.Row)" Value="0" />
                            <Setter Target="EventsCard.(Grid.Column)" Value="3" />
                            <Setter Target="ActionButtonsPanel.Orientation" Value="Horizontal" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <StackPanel Spacing="16">
                <Grid x:Name="HeaderGrid" RowSpacing="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition x:Name="HeaderCol1" Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Quick Status" Style="{StaticResource QuickHeadingStyle}" />
                        <TextBlock Text="Live snapshot of agent health and activity." Style="{StaticResource QuickSubtitleStyle}" />
                    </StackPanel>

                    <Border
                        x:Name="ConnectionPill"
                        Grid.Column="1"
                        CornerRadius="18"
                        Padding="16,8"
                        BorderBrush="{ThemeResource HeaderPanelBorderBrush}"
                        BorderThickness="1"
                        Background="{ThemeResource ChipSuccessBackgroundBrush}"
                        VerticalAlignment="Top">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Ellipse x:Name="ConnectionPillDot" Width="10" Height="10" Fill="{ThemeResource SuccessBrush}" />
                            <FontIcon x:Name="ConnectionPillIcon" Glyph="&#xE73E;" Foreground="{ThemeResource SuccessBrush}" FontSize="13" />
                            <TextBlock x:Name="ConnectionPillText" Foreground="{ThemeResource SuccessBrush}" FontSize="15" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Style="{StaticResource CardBorderStyle}" Padding="20,14">
                    <Grid ColumnSpacing="16" RowSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Spacing="4">
                            <TextBlock Text="DEVICE NAME" Style="{StaticResource QuickSectionLabelStyle}" />
                            <TextBlock x:Name="DeviceNameText" Style="{StaticResource QuickIdentityValueStyle}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxLines="2" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Spacing="4">
                            <TextBlock Text="DEVICE ID" Style="{StaticResource QuickSectionLabelStyle}" />
                            <TextBlock x:Name="DeviceIdText" Style="{StaticResource QuickIdentityValueStyle}" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
                            <TextBlock Text="AGENT VERSION" Style="{StaticResource QuickSectionLabelStyle}" />
                            <TextBlock x:Name="AgentVersionText" Style="{StaticResource QuickIdentityValueStyle}" />
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="0" Spacing="4">
                            <TextBlock Text="UPTIME" Style="{StaticResource QuickSectionLabelStyle}" />
                            <TextBlock x:Name="UptimeText" Style="{StaticResource QuickIdentityValueStyle}" />
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="1" Spacing="4">
                            <TextBlock Text="POLICY HASH" Style="{StaticResource QuickSectionLabelStyle}" />
                            <TextBlock x:Name="PolicyHashText" Style="{StaticResource QuickIdentityValueStyle}" TextTrimming="CharacterEllipsis" MaxLines="1" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid ColumnSpacing="14" RowSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="MetricCol0" Width="*" />
                        <ColumnDefinition x:Name="MetricCol1" Width="*" />
                        <ColumnDefinition x:Name="MetricCol2" Width="*" />
                        <ColumnDefinition x:Name="MetricCol3" Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <controls:MetricCard x:Name="LastSyncCard" Grid.Row="0" Grid.Column="0" Tone="Info" Glyph="&#xE823;" />
                    <controls:MetricCard x:Name="CpuCard" Grid.Row="0" Grid.Column="1" Tone="Success" Glyph="&#xE7F4;" />
                    <controls:MetricCard x:Name="MemoryCard" Grid.Row="0" Grid.Column="2" Tone="Info" Glyph="&#xE950;" />
                    <controls:MetricCard x:Name="EventsCard" Grid.Row="0" Grid.Column="3" Tone="Warning" Glyph="&#xE7BA;" />
                </Grid>

                <Border Style="{StaticResource CardBorderStyle}" Padding="24,18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE945;" Foreground="{ThemeResource SuccessBrush}" />
                                <TextBlock Text="CURRENT ACTIVITY" Style="{StaticResource QuickSectionLabelStyle}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock x:Name="ActivityText" FontSize="24" FontWeight="SemiBold" />
                            <TextBlock x:Name="ActivityDetailsText" Style="{StaticResource QuickSubtitleStyle}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="7" VerticalAlignment="Top">
                            <Ellipse Width="9" Height="9" Fill="{ThemeResource SuccessBrush}" Margin="0,6,0,0" />
                            <TextBlock Text="Live" Foreground="{ThemeResource SuccessBrush}" VerticalAlignment="Top" FontWeight="SemiBold" FontSize="14" />
                        </StackPanel>
                    </Grid>
                </Border>

                <StackPanel x:Name="ActionButtonsPanel" Orientation="Horizontal" Spacing="12">
                    <Button Click="OnOpenDashboard" Style="{StaticResource QuickActionPrimaryButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xECA5;" FontSize="16" />
                            <TextBlock Text="Open Dashboard" FontSize="14" FontWeight="SemiBold" />
                            <FontIcon Glyph="&#xE72A;" FontSize="13" />
                        </StackPanel>
                    </Button>
                    <Button Click="OnSyncNow" Style="{StaticResource QuickActionInfoButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE117;" FontSize="16" />
                            <TextBlock Text="Sync Now" FontSize="14" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                    <Button Click="OnViewLogs" Style="{StaticResource QuickActionNeutralButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE9D2;" FontSize="16" />
                            <TextBlock Text="View Logs" FontSize="14" FontWeight="SemiBold" />
                            <FontIcon Glyph="&#xE72A;" FontSize="13" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Border
                    x:Name="WarningPanel"
                    Background="{ThemeResource WarningPanelBackgroundBrush}"
                    BorderBrush="{ThemeResource WarningPanelBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="16">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <FontIcon
                            Glyph="&#xE7BA;"
                            Foreground="{ThemeResource ChipWarningForegroundBrush}"
                            FontSize="20"
                            Margin="4,2,0,0" />

                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock x:Name="WarningTitleText" Foreground="{ThemeResource ChipWarningForegroundBrush}" FontWeight="SemiBold" />
                            <TextBlock
                                x:Name="WarningDetailsText"
                                Foreground="{ThemeResource ChipWarningForegroundBrush}"
                                FontSize="14"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <TextBlock
                            x:Name="WarningReviewText"
                            Grid.Column="2"
                            Text="Review ->"
                            Foreground="{ThemeResource ChipWarningForegroundBrush}"
                            FontSize="14"
                            FontWeight="SemiBold"
                            VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>


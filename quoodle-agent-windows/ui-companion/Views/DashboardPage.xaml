<Page
    x:Class="Quoodle.Agent.UiCompanion.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:Quoodle.Agent.UiCompanion.Controls"
    mc:Ignorable="d"
    Background="{ThemeResource AppBackgroundBrush}">

    <ScrollViewer>
        <Grid Padding="28" MaxWidth="1280">
            <StackPanel Spacing="18">
                <StackPanel Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <TextBlock Text="Agent Dashboard" Style="{StaticResource PageTitleTextStyle}" />
                        <controls:StatusChip x:Name="ConnectionChip" Width="150"/>
                        <controls:StatusChip x:Name="HealthChip" Width="120"/>
                    </StackPanel>
                    <TextBlock Text="Live control-plane transport, telemetry, and command posture." Style="{StaticResource PageSubtitleTextStyle}" />
                </StackPanel>

                <Border
                    Padding="18"
                    Background="{ThemeResource HeaderPanelBackgroundBrush}"
                    BorderBrush="{ThemeResource HeaderPanelBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{ThemeResource Corner.Large}">
                    <Grid ColumnSpacing="20" RowSpacing="14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Spacing="4">
                            <TextBlock x:Name="IdentityText" FontWeight="SemiBold" FontSize="16"/>
                            <TextBlock x:Name="VersionText" Style="{StaticResource PageSubtitleTextStyle}"/>
                            <TextBlock x:Name="LastSyncText" Style="{StaticResource PageSubtitleTextStyle}"/>
                            <TextBlock x:Name="ActivityText" Style="{StaticResource PageSubtitleTextStyle}" TextWrapping="Wrap"/>
                        </StackPanel>

                        <Button Grid.Column="1" Content="Sync Now" Click="OnSyncNow" Style="{StaticResource AccentButtonStyle}"/>

                        <Grid Grid.Row="1" Grid.ColumnSpan="2" ColumnSpacing="22">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Spacing="3">
                                <TextBlock Text="Agent Version" Style="{StaticResource MutedTextStyle}" />
                                <TextBlock x:Name="HeroVersionText" FontWeight="SemiBold" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Spacing="3">
                                <TextBlock Text="OS Build" Style="{StaticResource MutedTextStyle}" />
                                <TextBlock x:Name="HeroBuildText" FontWeight="SemiBold" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" Spacing="3">
                                <TextBlock Text="Transport Status" Style="{StaticResource MutedTextStyle}" />
                                <TextBlock x:Name="HeroTransportText" FontWeight="SemiBold" />
                            </StackPanel>

                            <StackPanel Grid.Column="3" Spacing="3">
                                <TextBlock Text="Reconnect Attempts" Style="{StaticResource MutedTextStyle}" />
                                <TextBlock x:Name="HeroReconnectText" FontWeight="SemiBold" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <Grid ColumnSpacing="14" RowSpacing="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <controls:MetricCard
                        x:Name="CpuCard"
                        Grid.Row="0"
                        Grid.Column="0"
                        Tone="Success"
                        Glyph="&#xE7F4;" />
                    <controls:MetricCard
                        x:Name="MemoryCard"
                        Grid.Row="0"
                        Grid.Column="1"
                        Tone="Info"
                        Glyph="&#xE950;" />
                    <controls:MetricCard
                        x:Name="DiskCard"
                        Grid.Row="0"
                        Grid.Column="2"
                        Tone="Warning"
                        Glyph="&#xE958;" />

                    <controls:MetricCard
                        x:Name="RxCard"
                        Grid.Row="1"
                        Grid.Column="0"
                        Tone="Info"
                        Glyph="&#xE7F5;" />
                    <controls:MetricCard
                        x:Name="TxCard"
                        Grid.Row="1"
                        Grid.Column="1"
                        Tone="Info"
                        Glyph="&#xE8D5;" />

                    <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource CardBorderStyle}" Background="{ThemeResource SurfaceAltBrush}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Telemetry Summary" Style="{StaticResource MutedTextStyle}"/>
                            <TextBlock x:Name="TelemetrySummaryText" TextWrapping="Wrap" Style="{StaticResource PageSubtitleTextStyle}"/>
                            <TextBlock Text="High-fidelity dashboard overview aligned to the mock shell." Style="{StaticResource MutedTextStyle}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>

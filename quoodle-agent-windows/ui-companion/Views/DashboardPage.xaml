<Page
    x:Class="Quoodle.Agent.UiCompanion.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:Quoodle.Agent.UiCompanion.Controls"
    mc:Ignorable="d"
    Background="{ThemeResource AppBackgroundBrush}">

    <Page.Resources>
        <Style x:Key="DashboardHeadingStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="28" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="DashboardSubheadingStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style x:Key="HeroLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextMutedBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="CharacterSpacing" Value="80" />
        </Style>

        <Style x:Key="HeroValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="PanelTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="SegmentButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{ThemeResource TextMutedBrush}" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>
    </Page.Resources>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <Grid x:Name="DashboardRoot" Padding="14,6,14,14" MaxWidth="1320">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup>
                    <VisualState x:Name="NarrowState">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="0" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="HeroDetailGrid.Visibility" Value="Collapsed" />
                            <Setter Target="HeroCompactDetails.Visibility" Value="Visible" />
                            <Setter Target="HeroSessionPanel.Visibility" Value="Collapsed" />
                            <Setter Target="HeroDevicePanel.Visibility" Value="Collapsed" />
                            <Setter Target="HeroHeartbeatPanel.Visibility" Value="Collapsed" />
                            <Setter Target="MetricsCol0.Width" Value="*" />
                            <Setter Target="MetricsCol1.Width" Value="*" />
                            <Setter Target="MetricsCol2.Width" Value="0" />
                            <Setter Target="MetricsCol3.Width" Value="0" />
                            <Setter Target="WssUptimeCard.(Grid.ColumnSpan)" Value="2" />
                            <Setter Target="LastHeartbeatCard.(Grid.Row)" Value="1" />
                            <Setter Target="LastHeartbeatCard.(Grid.Column)" Value="0" />
                            <Setter Target="FailedCommandsCard.(Grid.Row)" Value="1" />
                            <Setter Target="FailedCommandsCard.(Grid.Column)" Value="1" />
                            <Setter Target="CommandsCompletedCard.(Grid.Row)" Value="2" />
                            <Setter Target="CommandsCompletedCard.(Grid.Column)" Value="0" />
                            <Setter Target="KernelEventsCard.(Grid.Row)" Value="2" />
                            <Setter Target="KernelEventsCard.(Grid.Column)" Value="1" />
                            <Setter Target="CpuUsageCard.(Grid.Row)" Value="3" />
                            <Setter Target="CpuUsageCard.(Grid.Column)" Value="0" />
                            <Setter Target="RamUsageCard.(Grid.Row)" Value="3" />
                            <Setter Target="RamUsageCard.(Grid.Column)" Value="1" />
                            <Setter Target="DiskUsageCard.(Grid.Row)" Value="4" />
                            <Setter Target="DiskUsageCard.(Grid.Column)" Value="0" />
                            <Setter Target="NetTxCard.(Grid.Row)" Value="4" />
                            <Setter Target="NetTxCard.(Grid.Column)" Value="1" />
                            <Setter Target="NetRxCard.(Grid.Row)" Value="5" />
                            <Setter Target="NetRxCard.(Grid.Column)" Value="0" />
                            <Setter Target="TelemetrySnapshotsCard.(Grid.Row)" Value="5" />
                            <Setter Target="TelemetrySnapshotsCard.(Grid.Column)" Value="1" />
                        </VisualState.Setters>
                    </VisualState>

                    <VisualState x:Name="MediumState">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="641" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="HeroDetailGrid.Visibility" Value="Collapsed" />
                            <Setter Target="HeroCompactDetails.Visibility" Value="Visible" />
                            <Setter Target="HeroSessionPanel.Visibility" Value="Collapsed" />
                            <Setter Target="HeroDevicePanel.Visibility" Value="Visible" />
                            <Setter Target="HeroHeartbeatPanel.Visibility" Value="Collapsed" />
                            <Setter Target="MetricsCol0.Width" Value="*" />
                            <Setter Target="MetricsCol1.Width" Value="*" />
                            <Setter Target="MetricsCol2.Width" Value="0" />
                            <Setter Target="MetricsCol3.Width" Value="0" />
                            <Setter Target="WssUptimeCard.(Grid.ColumnSpan)" Value="2" />
                            <Setter Target="LastHeartbeatCard.(Grid.Row)" Value="1" />
                            <Setter Target="LastHeartbeatCard.(Grid.Column)" Value="0" />
                            <Setter Target="FailedCommandsCard.(Grid.Row)" Value="1" />
                            <Setter Target="FailedCommandsCard.(Grid.Column)" Value="1" />
                            <Setter Target="CommandsCompletedCard.(Grid.Row)" Value="2" />
                            <Setter Target="CommandsCompletedCard.(Grid.Column)" Value="0" />
                            <Setter Target="KernelEventsCard.(Grid.Row)" Value="2" />
                            <Setter Target="KernelEventsCard.(Grid.Column)" Value="1" />
                            <Setter Target="CpuUsageCard.(Grid.Row)" Value="3" />
                            <Setter Target="CpuUsageCard.(Grid.Column)" Value="0" />
                            <Setter Target="RamUsageCard.(Grid.Row)" Value="3" />
                            <Setter Target="RamUsageCard.(Grid.Column)" Value="1" />
                            <Setter Target="DiskUsageCard.(Grid.Row)" Value="4" />
                            <Setter Target="DiskUsageCard.(Grid.Column)" Value="0" />
                            <Setter Target="NetTxCard.(Grid.Row)" Value="4" />
                            <Setter Target="NetTxCard.(Grid.Column)" Value="1" />
                            <Setter Target="NetRxCard.(Grid.Row)" Value="5" />
                            <Setter Target="NetRxCard.(Grid.Column)" Value="0" />
                            <Setter Target="TelemetrySnapshotsCard.(Grid.Row)" Value="5" />
                            <Setter Target="TelemetrySnapshotsCard.(Grid.Column)" Value="1" />
                        </VisualState.Setters>
                    </VisualState>

                    <VisualState x:Name="WideState">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="1200" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="HeroDetailGrid.Visibility" Value="Visible" />
                            <Setter Target="HeroCompactDetails.Visibility" Value="Collapsed" />
                            <Setter Target="HeroSessionPanel.Visibility" Value="Collapsed" />
                            <Setter Target="HeroDevicePanel.Visibility" Value="Visible" />
                            <Setter Target="HeroHeartbeatPanel.Visibility" Value="Visible" />
                            <Setter Target="MetricsCol0.Width" Value="*" />
                            <Setter Target="MetricsCol1.Width" Value="*" />
                            <Setter Target="MetricsCol2.Width" Value="*" />
                            <Setter Target="MetricsCol3.Width" Value="*" />
                            <Setter Target="WssUptimeCard.(Grid.ColumnSpan)" Value="2" />
                            <Setter Target="LastHeartbeatCard.(Grid.Row)" Value="0" />
                            <Setter Target="LastHeartbeatCard.(Grid.Column)" Value="2" />
                            <Setter Target="FailedCommandsCard.(Grid.Row)" Value="0" />
                            <Setter Target="FailedCommandsCard.(Grid.Column)" Value="3" />
                            <Setter Target="CommandsCompletedCard.(Grid.Row)" Value="1" />
                            <Setter Target="CommandsCompletedCard.(Grid.Column)" Value="0" />
                            <Setter Target="KernelEventsCard.(Grid.Row)" Value="1" />
                            <Setter Target="KernelEventsCard.(Grid.Column)" Value="1" />
                            <Setter Target="CpuUsageCard.(Grid.Row)" Value="1" />
                            <Setter Target="CpuUsageCard.(Grid.Column)" Value="2" />
                            <Setter Target="RamUsageCard.(Grid.Row)" Value="1" />
                            <Setter Target="RamUsageCard.(Grid.Column)" Value="3" />
                            <Setter Target="DiskUsageCard.(Grid.Row)" Value="2" />
                            <Setter Target="DiskUsageCard.(Grid.Column)" Value="0" />
                            <Setter Target="NetTxCard.(Grid.Row)" Value="2" />
                            <Setter Target="NetTxCard.(Grid.Column)" Value="1" />
                            <Setter Target="NetRxCard.(Grid.Row)" Value="2" />
                            <Setter Target="NetRxCard.(Grid.Column)" Value="2" />
                            <Setter Target="TelemetrySnapshotsCard.(Grid.Row)" Value="2" />
                            <Setter Target="TelemetrySnapshotsCard.(Grid.Column)" Value="3" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <StackPanel Spacing="12">
                <StackPanel Spacing="4">
                    <TextBlock Text="Overview" Style="{StaticResource DashboardHeadingStyle}" />
                    <TextBlock Text="Live agent health, telemetry, command execution, and current activity." Style="{StaticResource DashboardSubheadingStyle}" />
                </StackPanel>

                <Border
                    x:Name="HeroPanel"
                    CornerRadius="12"
                    Padding="0"
                    BorderBrush="{ThemeResource HeaderPanelBorderBrush}"
                    BorderThickness="1"
                    Background="{ThemeResource HeaderPanelBackgroundBrush}">
                    <StackPanel>
                        <Grid x:Name="HeroMetaStrip" Padding="14,10" ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel x:Name="HeroConnectionPanel" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Ellipse x:Name="ConnectionDot" Width="11" Height="11" Fill="{ThemeResource SuccessBrush}" />
                                <TextBlock x:Name="ConnectionText" Foreground="{ThemeResource SuccessBrush}" FontSize="15" FontWeight="SemiBold" />
                            </StackPanel>

                            <StackPanel x:Name="HeroSessionPanel" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Rectangle Width="1" Height="24" Fill="{ThemeResource BorderBrush}" />
                                <TextBlock Text="SESSION" Style="{StaticResource DashboardSubheadingStyle}" />
                                <TextBlock x:Name="SessionText" Foreground="{ThemeResource TextPrimaryBrush}" FontFamily="Consolas" FontSize="15" />
                            </StackPanel>

                            <StackPanel x:Name="HeroDevicePanel" Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Rectangle Width="1" Height="24" Fill="{ThemeResource BorderBrush}" />
                                <TextBlock Text="DEVICE" Style="{StaticResource DashboardSubheadingStyle}" />
                                <TextBlock x:Name="DeviceText" Foreground="{ThemeResource TextPrimaryBrush}" FontFamily="Consolas" FontSize="15" />
                            </StackPanel>

                            <StackPanel x:Name="HeroHeartbeatPanel" Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Rectangle Width="1" Height="24" Fill="{ThemeResource BorderBrush}" />
                                <FontIcon Glyph="&#xE121;" Foreground="{ThemeResource TextMutedBrush}" />
                                <TextBlock Text="Last heartbeat" Style="{StaticResource DashboardSubheadingStyle}" />
                                <TextBlock x:Name="HeartbeatText" Foreground="{ThemeResource TextPrimaryBrush}" FontWeight="SemiBold" />
                            </StackPanel>

                            <TextBlock x:Name="HeroDetailsHintText" Grid.Column="5" Text="Runtime summary" Style="{StaticResource DashboardSubheadingStyle}" VerticalAlignment="Center" />
                        </Grid>

                        <TextBlock
                            x:Name="HeroCompactDetails"
                            Visibility="Collapsed"
                            Margin="14,0,14,8"
                            Style="{StaticResource DashboardSubheadingStyle}"
                            Text="Open Settings for full identity and transport details." />

                        <Border Height="1" Background="{ThemeResource BorderBrush}" />

                        <Grid x:Name="HeroDetailGrid" Padding="14,10" ColumnSpacing="16" RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Spacing="2">
                                <TextBlock Text="AGENT VERSION" Style="{StaticResource HeroLabelStyle}" />
                                <TextBlock x:Name="AgentVersionText" Style="{StaticResource HeroValueStyle}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="1" Spacing="2">
                                <TextBlock Text="OS BUILD" Style="{StaticResource HeroLabelStyle}" />
                                <TextBlock x:Name="OsBuildText" Style="{StaticResource HeroValueStyle}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="2" Spacing="2">
                                <TextBlock Text="RECONNECT ATTEMPTS" Style="{StaticResource HeroLabelStyle}" />
                                <TextBlock x:Name="ReconnectText" Style="{StaticResource HeroValueStyle}" />
                            </StackPanel>
                        </Grid>

                        <Grid Visibility="Collapsed">
                            <TextBlock x:Name="HwidHashText" />
                            <TextBlock x:Name="PolicyHashText" />
                            <TextBlock x:Name="EndpointText" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Grid x:Name="MetricsGrid" ColumnSpacing="14" RowSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="MetricsCol0" Width="*" />
                        <ColumnDefinition x:Name="MetricsCol1" Width="*" />
                        <ColumnDefinition x:Name="MetricsCol2" Width="*" />
                        <ColumnDefinition x:Name="MetricsCol3" Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <controls:MetricCard x:Name="WssUptimeCard" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" />
                    <controls:MetricCard x:Name="LastHeartbeatCard" Grid.Row="0" Grid.Column="2" />
                    <controls:MetricCard x:Name="FailedCommandsCard" Grid.Row="0" Grid.Column="3" />

                    <controls:MetricCard x:Name="CommandsCompletedCard" Grid.Row="1" Grid.Column="0" />
                    <controls:MetricCard x:Name="KernelEventsCard" Grid.Row="1" Grid.Column="1" />
                    <controls:MetricCard x:Name="CpuUsageCard" Grid.Row="1" Grid.Column="2" />
                    <controls:MetricCard x:Name="RamUsageCard" Grid.Row="1" Grid.Column="3" />

                    <controls:MetricCard x:Name="DiskUsageCard" Grid.Row="2" Grid.Column="0" />
                    <controls:MetricCard x:Name="NetTxCard" Grid.Row="2" Grid.Column="1" />
                    <controls:MetricCard x:Name="NetRxCard" Grid.Row="2" Grid.Column="2" />
                    <controls:MetricCard x:Name="TelemetrySnapshotsCard" Grid.Row="2" Grid.Column="3" />
                </Grid>

                <Border Style="{StaticResource CardBorderStyle}" Padding="20,16">
                    <StackPanel Spacing="10">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Spacing="3">
                                <TextBlock Text="Telemetry Metrics" Style="{StaticResource PanelTitleStyle}" />
                                <TextBlock x:Name="TelemetrySubtitleText" Style="{StaticResource DashboardSubheadingStyle}" />
                            </StackPanel>

                            <Border Grid.Column="1" Background="{ThemeResource SurfaceAltBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1" CornerRadius="11" Padding="4">
                                <StackPanel Orientation="Horizontal" Spacing="2">
                                    <Button x:Name="CpuRamTabButton" Style="{StaticResource SegmentButtonStyle}" Content="CPU / RAM" Click="OnSelectCpuRam" />
                                    <Button x:Name="NetworkTabButton" Style="{StaticResource SegmentButtonStyle}" Content="Network" Click="OnSelectNetwork" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid Margin="0,8,0,0">
                            <Canvas x:Name="TelemetryChartCanvas" Height="252" SizeChanged="OnTelemetryChartCanvasSizeChanged" />
                            <TextBlock x:Name="TelemetryEmptyText" Text="No telemetry samples yet." Style="{StaticResource DashboardSubheadingStyle}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                        </Grid>
                        <Grid x:Name="TelemetryXAxisGrid" Margin="0,2,0,2" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorderStyle}" Padding="20,16">
                    <StackPanel Spacing="10">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Spacing="3">
                                <TextBlock Text="Command Execution" Style="{StaticResource PanelTitleStyle}" />
                                <TextBlock Text="Hourly breakdown - completed vs failed" Style="{StaticResource DashboardSubheadingStyle}" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Ellipse Width="10" Height="10" Fill="{ThemeResource SuccessBrush}" />
                                    <TextBlock Text="Completed" Style="{StaticResource DashboardSubheadingStyle}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Ellipse Width="10" Height="10" Fill="{ThemeResource DangerBrush}" />
                                    <TextBlock Text="Failed" Style="{StaticResource DashboardSubheadingStyle}" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,8,0,0">
                            <Canvas x:Name="CommandChartCanvas" Height="236" SizeChanged="OnCommandChartCanvasSizeChanged" />
                        </Grid>
                        <Grid x:Name="CommandXAxisGrid" Margin="0,2,0,2" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorderStyle}" Padding="0">
                    <StackPanel>
                        <Grid Padding="20,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE945;" Foreground="{ThemeResource SuccessBrush}" />
                                <TextBlock Text="Last Command" Style="{StaticResource PanelTitleStyle}" />
                            </StackPanel>

                            <Border x:Name="LastCommandStatusBadge" Grid.Column="1" CornerRadius="14" Padding="12,6" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock x:Name="LastCommandStatusText" FontSize="14" FontWeight="SemiBold" />
                                    <FontIcon Glyph="&#xE70D;" FontSize="12" Foreground="{ThemeResource TextMutedBrush}" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Height="1" Background="{ThemeResource BorderBrush}" />

                        <Grid Padding="20,16" ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Spacing="2">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock x:Name="LastCommandNameText" FontSize="24" FontWeight="SemiBold" FontFamily="Consolas" />
                                    <Border x:Name="LastCommandPriorityBadge" Background="{ThemeResource ChipNeutralBackgroundBrush}" CornerRadius="7" Padding="8,2" VerticalAlignment="Center">
                                        <TextBlock x:Name="LastCommandPriorityText" Foreground="{ThemeResource ChipNeutralForegroundBrush}" FontFamily="Consolas" FontSize="12" />
                                    </Border>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock x:Name="LastCommandIdText" Style="{StaticResource DashboardSubheadingStyle}" />
                                    <FontIcon Glyph="&#xE16F;" Foreground="{ThemeResource TextMutedBrush}" FontSize="12" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Spacing="4" HorizontalAlignment="Right">
                                <TextBlock x:Name="LastCommandTransportText" Foreground="{ThemeResource InfoBrush}" FontFamily="Consolas" FontSize="14" />
                                <TextBlock x:Name="LastCommandWorkerText" Style="{StaticResource DashboardSubheadingStyle}" HorizontalAlignment="Right" />
                            </StackPanel>
                        </Grid>

                        <Grid Padding="20,0,20,16" ColumnSpacing="22">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="STARTED" Style="{StaticResource HeroLabelStyle}" />
                                <TextBlock x:Name="LastCommandStartedText" Style="{StaticResource HeroValueStyle}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="COMPLETED" Style="{StaticResource HeroLabelStyle}" />
                                <TextBlock x:Name="LastCommandCompletedText" Style="{StaticResource HeroValueStyle}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="2">
                                <TextBlock Text="DURATION" Style="{StaticResource HeroLabelStyle}" />
                                <TextBlock x:Name="LastCommandDurationText" Style="{StaticResource HeroValueStyle}" />
                            </StackPanel>
                        </Grid>

                        <Border Margin="20,0,20,18" Padding="13,10" BorderBrush="{ThemeResource HeaderPanelBorderBrush}" BorderThickness="1" CornerRadius="9" Background="{ThemeResource HeaderPanelBackgroundBrush}">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon x:Name="LastCommandResultIcon" Glyph="&#xE73E;" Foreground="{ThemeResource SuccessBrush}" />
                                <TextBlock x:Name="LastCommandResultText" Foreground="{ThemeResource SuccessBrush}" FontSize="15" FontFamily="Consolas" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorderStyle}" Padding="0">
                    <StackPanel>
                        <Grid Padding="20,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Text="WSS Event Feed" Style="{StaticResource PanelTitleStyle}" />
                                <TextBlock x:Name="WssFeedSubtitleText" Style="{StaticResource DashboardSubheadingStyle}" />
                            </StackPanel>

                            <Button
                                Grid.Column="1"
                                Content="Full log ->"
                                Style="{StaticResource SegmentButtonStyle}"
                                Padding="8,4"
                                Click="OnOpenFullLog"
                                VerticalAlignment="Center" />
                        </Grid>

                        <Border Height="1" Background="{ThemeResource BorderBrush}" />
                        <StackPanel x:Name="WssFeedItemsPanel" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>

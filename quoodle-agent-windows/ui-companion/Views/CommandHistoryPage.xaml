<Page
    x:Class="Quoodle.Agent.UiCompanion.Views.CommandHistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:Quoodle.Agent.UiCompanion.Controls"
    xmlns:viewModels="using:Quoodle.Agent.UiCompanion.ViewModels"
    mc:Ignorable="d"
    Background="{ThemeResource AppBackgroundBrush}">

    <Grid Padding="28" MaxWidth="1260" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="4">
            <TextBlock Text="Command History" Style="{StaticResource PageTitleTextStyle}" />
            <TextBlock Text="Synthetic command lifecycle stream with active, succeeded, and failed states." Style="{StaticResource PageSubtitleTextStyle}" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="14">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.1*" />
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="ResultCountText" VerticalAlignment="Center" FontWeight="SemiBold" />
                <ComboBox x:Name="FilterBox" Grid.Column="1" SelectionChanged="OnFilterChanged" />
                <TextBox
                    x:Name="SearchBox"
                    Grid.Column="2"
                    PlaceholderText="Search by command, source, status, or id"
                    TextChanged="OnSearchChanged" />
            </Grid>
        </Border>

        <Grid Grid.Row="2" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.4*" />
                <ColumnDefinition Width="1.1*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="10">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border Background="{ThemeResource SurfaceAltBrush}" CornerRadius="10" Padding="10,6">
                            <TextBlock Text="Queued → Executing → Result" Style="{StaticResource MutedTextStyle}" />
                        </Border>
                    </StackPanel>

                    <ListView
                        Grid.Row="1"
                        x:Name="CommandList"
                        SelectionMode="None"
                        Background="Transparent"
                        BorderThickness="0">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="viewModels:CommandHistoryItem">
                                <Border
                                    Margin="0,0,0,10"
                                    Padding="16"
                                    Background="{ThemeResource SurfaceAltBrush}"
                                    BorderBrush="{ThemeResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{ThemeResource Corner.Medium}">
                                    <Grid ColumnSpacing="14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="170" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="150" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Spacing="4">
                                            <TextBlock Text="{x:Bind IssuedAt}" Style="{StaticResource MutedTextStyle}" />
                                            <TextBlock Text="{x:Bind Source}" Foreground="{ThemeResource BrandBrush}" />
                                            <TextBlock Text="{x:Bind Id}" Style="{StaticResource MutedTextStyle}" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Spacing="5">
                                            <TextBlock Text="{x:Bind Command}" FontWeight="SemiBold" FontSize="16" />
                                            <TextBlock Text="{x:Bind Error}" TextWrapping="Wrap" Style="{StaticResource PageSubtitleTextStyle}" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" HorizontalAlignment="Right" Spacing="8">
                                            <controls:StatusChip Label="{x:Bind Status}" Tone="{x:Bind Tone}" Width="132" />
                                            <TextBlock Text="{x:Bind Duration}" Style="{StaticResource MutedTextStyle}" HorizontalAlignment="Right" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <TextBlock
                        Grid.Row="2"
                        x:Name="EmptyStateText"
                        Text="No matching commands in the current filter."
                        Style="{StaticResource MutedTextStyle}"
                        Visibility="Collapsed" />
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Selected Command" Style="{StaticResource SectionTitleTextStyle}" />
                    <TextBlock Text="Use the search and filter controls to inspect the live mock stream." Style="{StaticResource PageSubtitleTextStyle}" TextWrapping="Wrap" />

                    <Border Background="{ThemeResource SurfaceAltBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1" CornerRadius="{ThemeResource Corner.Medium}" Padding="16">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Command envelope preview" Style="{StaticResource MutedTextStyle}" />
                            <TextBlock Text="No row selection is required for Milestone 1.5, but this surface is reserved for the future live bridge detail panel." TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Background="{ThemeResource ChipWarningBackgroundBrush}" CornerRadius="{ThemeResource Corner.Medium}" Padding="14">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Next bridge seam" Foreground="{ThemeResource ChipWarningForegroundBrush}" FontWeight="SemiBold" />
                            <TextBlock Text="When named-pipe or service projection lands, this panel becomes the per-command JSON/result inspector." TextWrapping="Wrap" Style="{StaticResource PageSubtitleTextStyle}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>

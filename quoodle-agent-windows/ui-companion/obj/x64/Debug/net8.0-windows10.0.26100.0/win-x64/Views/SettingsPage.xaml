<Page
    x:Class="Quoodle.Agent.UiCompanion.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource AppBackgroundBrush}">

    <ScrollViewer>
        <Grid Padding="28" MaxWidth="1220">
            <StackPanel Spacing="18">
                <StackPanel Spacing="6">
                    <TextBlock Text="Settings &amp; Configuration" Style="{StaticResource PageTitleTextStyle}" />
                    <TextBlock Text="Agent identity, transport, security, telemetry policy, and notifications." Style="{StaticResource PageSubtitleTextStyle}" />
                </StackPanel>

                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                        <StackPanel Spacing="14">
                            <TextBlock Text="Sections" Style="{StaticResource NavSectionTextStyle}" Margin="0" />
                            <Border Background="{ThemeResource NavSelectedBackgroundBrush}" BorderBrush="{ThemeResource NavSelectedBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12,10">
                                <TextBlock Text="Device Identity" FontSize="17" Foreground="{ThemeResource SuccessBrush}" FontWeight="SemiBold" />
                            </Border>
                            <TextBlock Text="Connection &amp; Transport" FontSize="17" />
                            <TextBlock Text="Security" FontSize="17" />
                            <TextBlock Text="Telemetry Policy" FontSize="17" />
                            <TextBlock Text="Notifications" FontSize="17" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}">
                        <StackPanel Spacing="18">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Spacing="4">
                                    <TextBlock Text="Device Identity" Style="{StaticResource SectionTitleTextStyle}" />
                                    <TextBlock Text="Read-only enrollment data with live local preferences below." Style="{StaticResource PageSubtitleTextStyle}" />
                                    <TextBlock x:ConnectionId='9' x:Name="IdentityText" FontWeight="SemiBold" />
                                </StackPanel>

                                <Border
                                    Grid.Column="1"
                                    Background="{ThemeResource ChipSuccessBackgroundBrush}"
                                    CornerRadius="14"
                                    Padding="12,6"
                                    VerticalAlignment="Top">
                                    <TextBlock Text="Enrolled" Foreground="{ThemeResource ChipSuccessForegroundBrush}" FontWeight="SemiBold" />
                                </Border>
                            </Grid>

                            <Grid ColumnSpacing="16" RowSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="14">
                                    <StackPanel Spacing="10">
                                        <TextBlock Text="Connection &amp; Transport" Style="{StaticResource SectionTitleTextStyle}" />
                                        <ToggleSwitch x:ConnectionId='7' x:Name="BackgroundSyncSwitch" Header="Background sync"                           />
                                        <ToggleSwitch x:ConnectionId='8' x:Name="StartupSwitch" Header="Start with Windows"                           />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource CardBorderStyle}" Padding="14">
                                    <StackPanel Spacing="10">
                                        <TextBlock Text="Security" Style="{StaticResource SectionTitleTextStyle}" />
                                        <ToggleSwitch x:ConnectionId='6' x:Name="DiagnosticsSwitch" Header="Collect diagnostics"                           />
                                        <TextBlock Text="Kernel bridge and attestation hooks remain service-owned; UI is projection only." Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="14">
                                    <StackPanel Spacing="10">
                                        <TextBlock Text="Notifications" Style="{StaticResource SectionTitleTextStyle}" />
                                        <ToggleSwitch x:ConnectionId='3' x:Name="NotifyInfoSwitch" Header="Info notifications"                           />
                                        <ToggleSwitch x:ConnectionId='4' x:Name="NotifyCriticalSwitch" Header="Warning / critical notifications"                           />
                                        <ToggleSwitch x:ConnectionId='5' x:Name="TraySwitch" Header="Allow tray notifications"                           />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource CardBorderStyle}" Padding="14">
                                    <StackPanel Spacing="10">
                                        <TextBlock Text="Telemetry Policy" Style="{StaticResource SectionTitleTextStyle}" />
                                        <TextBlock Text="These values are stored in mock in-memory state today and become the seam for the service bridge later." Style="{StaticResource PageSubtitleTextStyle}" TextWrapping="Wrap" />
                                        <Button x:ConnectionId='2' Content="Sync Now" HorizontalAlignment="Left"                   Style="{StaticResource AccentButtonStyle}" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>


<UserControl
    x:Class="Quoodle.Agent.UiCompanion.Controls.TimelineRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Border
        Padding="14"
        Background="{ThemeResource SurfaceBrush}"
        BorderBrush="{ThemeResource SurfaceAltBrush}"
        BorderThickness="1"
        CornerRadius="{ThemeResource Corner.Medium}">
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="120" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock x:ConnectionId='6' x:Name="TimeText" FontSize="11" Opacity="0.75"/>
                <TextBlock x:ConnectionId='7' x:Name="SourceText" FontSize="11" Opacity="0.65"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Spacing="2">
                <TextBlock x:ConnectionId='4' x:Name="TitleText" FontWeight="SemiBold"/>
                <TextBlock x:ConnectionId='5' x:Name="DetailsText" TextWrapping="Wrap" Opacity="0.8" FontSize="12"/>
            </StackPanel>

            <Border x:ConnectionId='2' x:Name="SeverityPill" Grid.Column="2" HorizontalAlignment="Right" CornerRadius="12" Padding="8,3" Background="{ThemeResource NeutralBrush}">
                <TextBlock x:ConnectionId='3' x:Name="SeverityText" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
            </Border>
        </Grid>
    </Border>
</UserControl>


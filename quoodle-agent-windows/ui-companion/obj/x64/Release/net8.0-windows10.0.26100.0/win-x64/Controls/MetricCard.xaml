<UserControl
    x:Class="Quoodle.Agent.UiCompanion.Controls.MetricCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Border
        Background="{ThemeResource SurfaceBrush}"
        BorderBrush="{ThemeResource SurfaceAltBrush}"
        BorderThickness="1"
        CornerRadius="{ThemeResource Corner.Medium}"
        Padding="16"
        MinWidth="180">
        <StackPanel Spacing="6">
            <TextBlock x:ConnectionId='2' x:Name="TitleText" Opacity="0.72" FontSize="12"/>
            <TextBlock x:ConnectionId='3' x:Name="ValueText" FontSize="26" FontWeight="SemiBold"/>
            <TextBlock x:ConnectionId='4' x:Name="SubtitleText" Opacity="0.75" FontSize="11"/>
        </StackPanel>
    </Border>
</UserControl>


<Page
    x:Class="Quoodle.Agent.UiCompanion.Views.OnboardingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:Quoodle.Agent.UiCompanion.Controls"
    mc:Ignorable="d"
    Background="{ThemeResource AppBackgroundBrush}">

    <ScrollViewer>
        <Grid Padding="28" MaxWidth="980">
            <StackPanel Spacing="20">
                <TextBlock Text="Onboarding" FontSize="28" FontWeight="SemiBold"/>
                <TextBlock Text="Guided local onboarding flow aligned to the mock screens." Opacity="0.75"/>

                <Border Background="{ThemeResource SurfaceBrush}" CornerRadius="{ThemeResource Corner.Large}" Padding="20" BorderBrush="{ThemeResource SurfaceAltBrush}" BorderThickness="1">
                    <StackPanel Spacing="12">
                        <TextBlock x:ConnectionId='2' x:Name="StepTitleText" FontSize="22" FontWeight="SemiBold" />
                        <ProgressBar x:ConnectionId='3' x:Name="StepProgress" Height="8" Minimum="0" Maximum="100" />
                        <TextBlock x:ConnectionId='4' x:Name="StepHintText" TextWrapping="Wrap" Opacity="0.82" />
                        <TextBox x:ConnectionId='5' x:Name="PairTokenBox" Header="Pairing token / device id" PlaceholderText="auto-generated if blank"                                     />

                        <controls:ActionButtonBar x:ConnectionId='6' x:Name="Actions" PrimaryText="Next" SecondaryText="Back" />
                        <Button x:ConnectionId='7' x:Name="CompleteButton" Content="Complete Pairing" HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>


<Page
    x:Class="Quoodle.Agent.UiCompanion.Views.CommandHistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:Quoodle.Agent.UiCompanion.Controls"
    xmlns:viewModels="using:Quoodle.Agent.UiCompanion.ViewModels"
    mc:Ignorable="d"
    Background="{ThemeResource AppBackgroundBrush}">

    <Grid Padding="28" MaxWidth="1200" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="4">
            <TextBlock Text="Command History" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Text="Mock command lifecycle stream with filter and local search." Opacity="0.76" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ComboBox x:ConnectionId='14' x:Name="FilterBox"                                    />
            <TextBox x:ConnectionId='15'
                x:Name="SearchBox"
                Grid.Column="1"
                PlaceholderText="Search by command, source, status, or id"
                                              />
        </Grid>

        <Grid Grid.Row="2" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock x:ConnectionId='2' x:Name="ResultCountText" Opacity="0.78" />

            <ListView x:ConnectionId='3'
                Grid.Row="1"
                x:Name="CommandList"
                SelectionMode="None"
                Background="Transparent"
                BorderThickness="0">
                <ListView.ItemTemplate>
                    <DataTemplate                                           >
                        <Border x:ConnectionId='6'
                            Margin="0,0,0,10"
                            Padding="14"
                            Background="{ThemeResource SurfaceBrush}"
                            BorderBrush="{ThemeResource SurfaceAltBrush}"
                            BorderThickness="1"
                            CornerRadius="{ThemeResource Corner.Medium}">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="150" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock x:ConnectionId='11'                          FontSize="11" Opacity="0.78" />
                                    <TextBlock x:ConnectionId='12'                        FontSize="11" Opacity="0.65" />
                                    <TextBlock x:ConnectionId='13'                    FontSize="11" Opacity="0.55" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Spacing="3">
                                    <TextBlock x:ConnectionId='9'                         FontWeight="SemiBold" />
                                    <TextBlock x:ConnectionId='10'                       TextWrapping="Wrap" Opacity="0.8" FontSize="12" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" HorizontalAlignment="Right" Spacing="6">
                                    <controls:StatusChip x:ConnectionId='7'                                              Width="130" />
                                    <TextBlock x:ConnectionId='8'                          FontSize="12" HorizontalAlignment="Right" Opacity="0.8" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <TextBlock x:ConnectionId='4'
                Grid.Row="2"
                x:Name="EmptyStateText"
                Text="No matching commands in the current filter."
                Opacity="0.72"
                Visibility="Collapsed" />
        </Grid>
    </Grid>
</Page>


<Page
    x:Class="Quoodle.Agent.UiCompanion.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource AppBackgroundBrush}">

    <ScrollViewer>
        <Grid Padding="28" MaxWidth="980">
            <StackPanel Spacing="16">
                <TextBlock Text="Settings &amp; Configuration" FontSize="28" FontWeight="SemiBold" />

                <Border Background="{ThemeResource SurfaceBrush}" CornerRadius="{ThemeResource Corner.Large}" Padding="18" BorderBrush="{ThemeResource SurfaceAltBrush}" BorderThickness="1">
                    <StackPanel Spacing="10">
                        <TextBlock x:ConnectionId='2' x:Name="IdentityText" FontWeight="SemiBold" />
                        <ToggleSwitch x:ConnectionId='3' x:Name="NotifyInfoSwitch" Header="Info notifications"                           />
                        <ToggleSwitch x:ConnectionId='4' x:Name="NotifyCriticalSwitch" Header="Warning/Critical notifications"                           />
                        <ToggleSwitch x:ConnectionId='5' x:Name="BackgroundSyncSwitch" Header="Background sync"                           />
                        <ToggleSwitch x:ConnectionId='6' x:Name="DiagnosticsSwitch" Header="Collect diagnostics"                           />
                        <ToggleSwitch x:ConnectionId='7' x:Name="StartupSwitch" Header="Start with Windows"                           />
                        <ToggleSwitch x:ConnectionId='8' x:Name="TraySwitch" Header="Allow tray notifications"                           />
                        <Button x:ConnectionId='9' Content="Sync Now" HorizontalAlignment="Left"                   Style="{StaticResource AccentButtonStyle}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>


<Page
    x:Class="Quoodle.Agent.UiCompanion.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:Quoodle.Agent.UiCompanion.Controls"
    mc:Ignorable="d"
    Background="{ThemeResource AppBackgroundBrush}">

    <ScrollViewer>
        <Grid Padding="28" MaxWidth="1200">
            <StackPanel Spacing="18">
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <TextBlock Text="Dashboard" FontSize="28" FontWeight="SemiBold"/>
                    <controls:StatusChip x:ConnectionId='12' x:Name="ConnectionChip" Width="128"/>
                    <controls:StatusChip x:ConnectionId='13' x:Name="HealthChip" Width="128"/>
                </StackPanel>

                <Border Background="{ThemeResource SurfaceBrush}" CornerRadius="{ThemeResource Corner.Large}" Padding="18" BorderBrush="{ThemeResource SurfaceAltBrush}" BorderThickness="1">
                    <Grid ColumnSpacing="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Spacing="4">
                            <TextBlock x:ConnectionId='8' x:Name="IdentityText" FontWeight="SemiBold" FontSize="16"/>
                            <TextBlock x:ConnectionId='9' x:Name="VersionText" Opacity="0.78"/>
                            <TextBlock x:ConnectionId='10' x:Name="LastSyncText" Opacity="0.78"/>
                            <TextBlock x:ConnectionId='11' x:Name="ActivityText" Opacity="0.88" TextWrapping="Wrap"/>
                        </StackPanel>

                        <Button x:ConnectionId='7' Grid.Column="1" Content="Sync Now"                   Style="{StaticResource AccentButtonStyle}"/>
                    </Grid>
                </Border>

                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <controls:MetricCard x:ConnectionId='2' x:Name="CpuCard" Grid.Column="0" />
                    <controls:MetricCard x:ConnectionId='3' x:Name="MemoryCard" Grid.Column="1" />
                    <controls:MetricCard x:ConnectionId='4' x:Name="DiskCard" Grid.Column="2" />
                    <controls:MetricCard x:ConnectionId='5' x:Name="RxCard" Grid.Column="3" />
                    <controls:MetricCard x:ConnectionId='6' x:Name="TxCard" Grid.Column="4" />
                </Grid>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>


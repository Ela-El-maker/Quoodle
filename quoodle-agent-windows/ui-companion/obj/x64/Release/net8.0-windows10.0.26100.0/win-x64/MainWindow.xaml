<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Quoodle.Agent.UiCompanion.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    Title="Quoodle Agent Companion"
    mc:Ignorable="d">
    <Grid Background="{ThemeResource AppBackgroundBrush}">
        <controls:NavigationView x:ConnectionId='2'
            x:Name="AppNav"
            IsSettingsVisible="False"
            PaneDisplayMode="Left"
                                                 
            Background="{ThemeResource AppBackgroundBrush}"
            PaneTitle="Quoodle Agent">
            <controls:NavigationView.Header>
                <Grid Padding="12,8">
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="10"
                        VerticalAlignment="Center">
                        <FontIcon
                            Glyph="&#xE7B8;"
                            FontSize="20"
                            Foreground="{ThemeResource BrandBrush}" />
                        <StackPanel>
                            <TextBlock Text="Endpoint Companion" FontWeight="SemiBold" />
                            <TextBlock x:ConnectionId='3'
                                x:Name="HeaderStatusText"
                                FontSize="12"
                                Opacity="0.75" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </controls:NavigationView.Header>

            <controls:NavigationView.MenuItems>
                <controls:NavigationViewItem Content="Onboarding" Tag="onboarding">
                    <controls:NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Contact" />
                    </controls:NavigationViewItem.Icon>
                </controls:NavigationViewItem>
                <controls:NavigationViewItem Content="Dashboard" Tag="dashboard">
                    <controls:NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Home" />
                    </controls:NavigationViewItem.Icon>
                </controls:NavigationViewItem>
                <controls:NavigationViewItem Content="Device Details" Tag="device-details">
                    <controls:NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Admin" />
                    </controls:NavigationViewItem.Icon>
                </controls:NavigationViewItem>
                <controls:NavigationViewItem Content="Command History" Tag="command-history">
                    <controls:NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Document" />
                    </controls:NavigationViewItem.Icon>
                </controls:NavigationViewItem>
                <controls:NavigationViewItem Content="Pairing Recovery" Tag="pairing-recovery">
                    <controls:NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Repair" />
                    </controls:NavigationViewItem.Icon>
                </controls:NavigationViewItem>
                <controls:NavigationViewItem Content="Quick Status" Tag="quick-status">
                    <controls:NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Clock" />
                    </controls:NavigationViewItem.Icon>
                </controls:NavigationViewItem>
                <controls:NavigationViewItem Content="Activity &amp; Diagnostics" Tag="activity">
                    <controls:NavigationViewItem.Icon>
                        <SymbolIcon Symbol="List" />
                    </controls:NavigationViewItem.Icon>
                </controls:NavigationViewItem>
                <controls:NavigationViewItem Content="Settings" Tag="settings">
                    <controls:NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Setting" />
                    </controls:NavigationViewItem.Icon>
                </controls:NavigationViewItem>
            </controls:NavigationView.MenuItems>

            <controls:NavigationView.FooterMenuItems>
                <controls:NavigationViewItem x:ConnectionId='4'
                    x:Name="ConnectionFooter"
                    Content="Connection: --"
                    IsEnabled="False">
                    <controls:NavigationViewItem.Icon>
                        <SymbolIcon Symbol="World" />
                    </controls:NavigationViewItem.Icon>
                </controls:NavigationViewItem>
            </controls:NavigationView.FooterMenuItems>

            <Frame x:ConnectionId='5' x:Name="ContentFrame" />
        </controls:NavigationView>
    </Grid>
</Window>


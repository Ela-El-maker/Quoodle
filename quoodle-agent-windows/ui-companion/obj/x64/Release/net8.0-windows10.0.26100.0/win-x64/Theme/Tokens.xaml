<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="Color.Brand">#FF1A8FE3</Color>
    <Color x:Key="Color.AppBackground">#FFF4F7FB</Color>
    <Color x:Key="Color.Surface">#FFFFFFFF</Color>
    <Color x:Key="Color.SurfaceAlt">#FFEAF0F7</Color>
    <Color x:Key="Color.Success">#FF1E8E3E</Color>
    <Color x:Key="Color.Warning">#FFE78A00</Color>
    <Color x:Key="Color.Danger">#FFD93025</Color>
    <Color x:Key="Color.Neutral">#FF475467</Color>

    <SolidColorBrush x:Key="BrandBrush" Color="{StaticResource Color.Brand}" />
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource Color.AppBackground}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource Color.Surface}" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="{StaticResource Color.SurfaceAlt}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource Color.Success}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource Color.Warning}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource Color.Danger}" />
    <SolidColorBrush x:Key="NeutralBrush" Color="{StaticResource Color.Neutral}" />

    <x:Double x:Key="Spacing.XS">6</x:Double>
    <x:Double x:Key="Spacing.SM">10</x:Double>
    <x:Double x:Key="Spacing.MD">16</x:Double>
    <x:Double x:Key="Spacing.LG">24</x:Double>
    <x:Double x:Key="Spacing.XL">32</x:Double>

    <CornerRadius x:Key="Corner.Small">8</CornerRadius>
    <CornerRadius x:Key="Corner.Medium">12</CornerRadius>
    <CornerRadius x:Key="Corner.Large">18</CornerRadius>
</ResourceDictionary>


<UserControl
    x:Class="Quoodle.Agent.UiCompanion.Controls.StatusChip"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Border
        x:Name="ChipBorder"
        Style="{StaticResource StatusChipBorderStyle}"
        Padding="12,6"
        CornerRadius="16"
        BorderThickness="1">
        <StackPanel x:Name="ChipContent" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
            <Ellipse
                x:Name="ToneDot"
                Width="9"
                Height="9"
                Fill="{ThemeResource ChipNeutralForegroundBrush}" />
            <TextBlock
                x:Name="ChipText"
                FontWeight="SemiBold"
                Foreground="{ThemeResource ChipNeutralForegroundBrush}"
                FontSize="13"
                Text="Unknown" />
        </StackPanel>
    </Border>
</UserControl>

<UserControl
    x:Class="Quoodle.Agent.UiCompanion.Controls.TimelineRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Border
        Padding="14"
        Background="{ThemeResource SurfaceBrush}"
        BorderBrush="{ThemeResource BorderBrush}"
        BorderThickness="1"
        CornerRadius="12">
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="140" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Spacing="2">
                <TextBlock x:Name="TimeText" Style="{StaticResource MutedTextStyle}"/>
                <TextBlock x:Name="SourceText" Style="{StaticResource MutedTextStyle}"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Spacing="3">
                <TextBlock x:Name="TitleText" FontWeight="SemiBold"/>
                <TextBlock x:Name="DetailsText" TextWrapping="Wrap" Style="{StaticResource PageSubtitleTextStyle}"/>
            </StackPanel>

            <Border
                x:Name="SeverityPill"
                Grid.Column="2"
                HorizontalAlignment="Right"
                CornerRadius="12"
                Padding="10,4"
                BorderBrush="{ThemeResource BorderBrush}"
                BorderThickness="1"
                Background="{ThemeResource ChipNeutralBackgroundBrush}">
                <TextBlock
                    x:Name="SeverityText"
                    Foreground="{ThemeResource ChipNeutralForegroundBrush}"
                    FontSize="11"
                    FontWeight="SemiBold"/>
            </Border>
        </Grid>
    </Border>
</UserControl>

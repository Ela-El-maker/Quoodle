<UserControl
    x:Class="Quoodle.Agent.UiCompanion.Controls.MetricCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Border
        x:Name="CardBorder"
        Style="{StaticResource CardBorderStyle}"
        MinWidth="136"
        MinHeight="124"
        Padding="14,10">
        <StackPanel Spacing="10">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border
                    x:Name="IconHost"
                    Width="32"
                    Height="32"
                    CornerRadius="8"
                    Background="{ThemeResource SurfaceAltBrush}">
                    <FontIcon
                        x:Name="GlyphIcon"
                        Glyph="&#xE946;"
                        Foreground="{ThemeResource BrandBrush}"
                        FontSize="15"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />
                </Border>

                <TextBlock
                    x:Name="TitleText"
                    Grid.Column="1"
                    Style="{StaticResource MutedTextStyle}"
                    VerticalAlignment="Center"
                    TextWrapping="Wrap"
                    MaxLines="2"
                    Margin="4,0,0,0" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Top">
                    <Border
                        x:Name="StatusBadgeHost"
                        Visibility="Collapsed"
                        Style="{StaticResource StatusChipBorderStyle}"
                        CornerRadius="10"
                        Padding="8,4">
                        <TextBlock x:Name="StatusBadgeText" FontSize="12" FontWeight="SemiBold" />
                    </Border>
                    <Border
                        x:Name="CountBadgeHost"
                        Visibility="Collapsed"
                        Style="{StaticResource StatusChipBorderStyle}"
                        CornerRadius="12"
                        Padding="8,4">
                        <TextBlock x:Name="CountBadgeText" FontSize="12" FontWeight="SemiBold" />
                    </Border>
                </StackPanel>
            </Grid>

            <TextBlock
                x:Name="ValueText"
                FontSize="22"
                FontWeight="SemiBold"
                Foreground="{ThemeResource TextPrimaryBrush}"
                TextWrapping="Wrap"
                MaxLines="1" />

            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    x:Name="SubtitleText"
                    Style="{StaticResource MutedTextStyle}"
                    TextWrapping="Wrap"
                    MaxLines="2" />

                <TextBlock
                    x:Name="DeltaTextBlock"
                    Grid.Column="1"
                    Visibility="Collapsed"
                    FontSize="13"
                    FontWeight="SemiBold"
                    VerticalAlignment="Bottom" />
            </Grid>
        </StackPanel>
    </Border>
</UserControl>

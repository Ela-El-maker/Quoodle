<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Quoodle.Agent.UiCompanion.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    Title="Quoodle Agent Companion"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource AppBackgroundBrush}">
        <controls:NavigationView
            x:Name="AppNav"
            IsSettingsVisible="False"
            IsBackButtonVisible="Collapsed"
            IsTitleBarAutoPaddingEnabled="False"
            OpenPaneLength="320"
            CompactPaneLength="56"
            PaneDisplayMode="Left"
            SelectionChanged="OnSelectionChanged"
            Background="{ThemeResource ShellBackgroundBrush}">

            <controls:NavigationView.PaneCustomContent>
                <Border BorderBrush="{ThemeResource BorderBrush}" BorderThickness="0,0,0,1">
                    <Grid Padding="20,18,20,14">
                        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <Border
                                Width="38"
                                Height="38"
                                CornerRadius="11"
                                Background="#FF2F3365">
                                <FontIcon
                                    Glyph="&#xE774;"
                                    Foreground="#FFD9AA44"
                                    FontSize="20"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                            </Border>

                            <StackPanel>
                                <TextBlock Text="QuoodleAgent" FontSize="34" FontWeight="SemiBold" />
                                <TextBlock x:Name="PaneVersionText" Style="{StaticResource MutedTextStyle}" Text="v0.0.1 • PC001" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            </controls:NavigationView.PaneCustomContent>

            <controls:NavigationView.MenuItems>
                <controls:NavigationViewItemHeader Content="MONITOR" />
<controls:NavigationViewItem Content="Device Onboarding" Tag="onboarding">
                    <controls:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE77B;" />
                    </controls:NavigationViewItem.Icon>
                </controls:NavigationViewItem>

                <controls:NavigationViewItem Content="Agent Dashboard" Tag="dashboard">
                    <controls:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xF246;" />
                    </controls:NavigationViewItem.Icon>
                </controls:NavigationViewItem>

                <controls:NavigationViewItem Content="Quick Status" Tag="quick-status">
                    <controls:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9CE;" />
                    </controls:NavigationViewItem.Icon>
                </controls:NavigationViewItem>

                <controls:NavigationViewItem Content="Activity &amp; Diagnostics" Tag="activity">
                    <controls:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEC4F;" />
                    </controls:NavigationViewItem.Icon>
                </controls:NavigationViewItem>

                <controls:NavigationViewItem Content="Settings &amp; Config" Tag="settings">
                    <controls:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </controls:NavigationViewItem.Icon>
                </controls:NavigationViewItem>

                            </controls:NavigationView.MenuItems>

            <controls:NavigationView.PaneFooter>
                <StackPanel Padding="14,10,14,14" Spacing="8">
                    <TextBlock Text="AGENT STATUS" Style="{StaticResource NavSectionTextStyle}" Margin="0" />
                    <TextBlock x:Name="StatusLine1" Style="{StaticResource PageSubtitleTextStyle}" Text="WSS Connected" />
                    <TextBlock x:Name="StatusLine2" Style="{StaticResource PageSubtitleTextStyle}" Text="Kernel Guard Active" />
                    <TextBlock x:Name="StatusLine3" Style="{StaticResource PageSubtitleTextStyle}" Text="Policy Matched" />
                    <Border
                        Background="{ThemeResource WarningPanelBackgroundBrush}"
                        BorderBrush="{ThemeResource WarningPanelBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="10,8">
                        <TextBlock
                            x:Name="KernelHintText"
                            Foreground="{ThemeResource ChipWarningForegroundBrush}"
                            FontSize="14"
                            Text="0 kernel events pending review" />
                    </Border>
                </StackPanel>
            </controls:NavigationView.PaneFooter>

            <controls:NavigationView.Header>
                <Border Visibility="Collapsed">
                    <Grid>
                        <TextBlock x:Name="HeaderConnectionText" />
                        <TextBlock x:Name="HeaderSessionText" />
                        <TextBlock x:Name="HeaderDeviceText" />
                        <TextBlock x:Name="HeaderHeartbeatText" />
                        <TextBlock x:Name="HeaderVersionText" />
                        <TextBlock x:Name="HeaderBuildText" />
                        <TextBlock x:Name="HeaderPolicyText" />
                        <TextBlock x:Name="HeaderLatencyText" />
                    </Grid>
                </Border>
            </controls:NavigationView.Header>

            <Frame x:Name="ContentFrame" Margin="14,8,14,14" />
        </controls:NavigationView>
    </Grid>
</Window>

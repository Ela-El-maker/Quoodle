{
  "LinuxIntegration": {
    "meta": {
      "version": "1.0",
      "compatibility_goal": "No changes required to Mobile, Laravel Control Plane, or FastAPI Gateway. Linux endpoint behaves as a protocol-equal peer to Windows endpoints.",
      "design_principles": [
        "Protocol compatibility first (match Agent↔FastAPI envelope + message types)",
        "Privileged boundary is local-only and allowlist-only",
        "Everything is signed, replay-protected, idempotent, and auditable",
        "Same user flow and state machine across OS platforms"
      ]
    },

    "components": {
      "quoodle_agent_linux": {
        "role": "Network-facing endpoint agent (unprivileged where possible)",
        "responsibilities": [
          "WSS session lifecycle with FastAPI (AUTH, HEARTBEAT)",
          "Verify inbound signatures and schema",
          "Policy application and policy_hash maintenance",
          "Command lifecycle handling (DELIVERY → ACK → RESULT)",
          "Telemetry/alerts publishing",
          "Local queueing for retries (persistent)"
        ],
        "local_state": [
          "device_id",
          "session_id",
          "policy_version",
          "policy_hash",
          "replay_cache (nonce/message_id)",
          "pending_outbox (ack/result/telemetry)",
          "agent_sequence (monotonic for privileged calls)"
        ]
      },

      "quoodle_privileged_daemon": {
        "role": "Local privileged executor (root-owned), protocol-compatible with kernel boundary semantics",
        "responsibilities": [
          "Verify schema + signature of local requests",
          "Enforce strict monotonic agent_sequence",
          "Enforce policy_hash pinning",
          "Allowlist operations only (no dynamic code paths)",
          "Emit tamper-resistant local audit entries",
          "Return signed responses"
        ],
        "security_controls": [
          "Local-only transport (UDS or equivalent)",
          "Peer credential verification (UID/GID)",
          "Strict allowlist mapping to internal operations",
          "Rate limiting and timeouts",
          "No shell execution; no free-form command strings"
        ]
      }
    },

    "protocols": {
      "AgentFastAPI": {
        "envelope": {
          "name": "CommonEnvelope",
          "fields": [
            "message_id",
            "timestamp",
            "type",
            "from",
            "device_id",
            "session_id",
            "body",
            "sig"
          ],
          "rules": [
            "sig is Ed25519 signature over canonical JSON excluding sig",
            "timestamp is ISO8601 UTC",
            "message_id is unique and used for dedupe"
          ]
        },
        "message_types": [
          "AUTH",
          "AUTH_ACK",
          "AUTH_ERROR",
          "HEARTBEAT",
          "POLICY_UPDATE",
          "COMMAND_DELIVERY",
          "COMMAND_ACK",
          "COMMAND_RESULT",
          "TELEMETRY",
          "ALERT",
          "ERROR"
        ],
        "reliability": {
          "dedupe_keys": ["device_id", "message_id"],
          "retry_policy": "exponential_backoff_with_jitter",
          "ordering_policy": "state_machine_precedence; ignore stale events"
        }
      },

      "AgentPrivilegedDaemon": {
        "request_schema": {
          "fields": [
            "request_id",
            "timestamp",
            "opcode",
            "params",
            "agent_sequence",
            "policy_hash",
            "command_message_id",
            "signature"
          ],
          "rules": [
            "signature is Ed25519 over canonical JSON of entire request",
            "agent_sequence must be strictly increasing per device_id",
            "opcode must be in allowlist",
            "policy_hash must match active committed policy"
          ]
        },
        "response_schema": {
          "fields": [
            "request_id",
            "timestamp",
            "status",
            "result",
            "error_code",
            "signature"
          ],
          "rules": [
            "signature is Ed25519 over canonical JSON of entire response",
            "request_id must match",
            "status is ok|error"
          ]
        }
      }
    },

    "state_machines": {
      "session": {
        "states": ["disconnected", "auth_sent", "online", "degraded"],
        "transitions": [
          { "from": "disconnected", "to": "auth_sent", "on": "WSS_CONNECT" },
          { "from": "auth_sent", "to": "online", "on": "AUTH_ACK" },
          { "from": "online", "to": "degraded", "on": "RECONNECTING" },
          { "from": "degraded", "to": "online", "on": "AUTH_ACK" }
        ]
      },
      "command": {
        "states": ["received", "acked", "executing", "completed", "failed"],
        "rules": [
          "ACK is idempotent: same command_message_id yields same ACK",
          "RESULT is idempotent: same command_message_id yields same terminal result",
          "If result already terminal, ignore duplicates"
        ]
      }
    },

    "flows": {
      "F1_WSS_AUTH": {
        "type": "async",
        "steps": [
          {
            "n": 1,
            "from": "quoodle_agent_linux",
            "to": "FastAPI",
            "message_type": "AUTH",
            "must_log": ["trace_id", "message_id", "device_id"]
          },
          {
            "n": 2,
            "from": "FastAPI",
            "to": "quoodle_agent_linux",
            "message_type": "AUTH_ACK",
            "must_log": ["trace_id", "session_id"]
          }
        ]
      },

      "F2_POLICY_UPDATE": {
        "type": "async",
        "steps": [
          {
            "n": 1,
            "from": "FastAPI",
            "to": "quoodle_agent_linux",
            "message_type": "POLICY_UPDATE"
          },
          {
            "n": 2,
            "local": "quoodle_agent_linux",
            "action": "commit_policy_atomically",
            "outputs": ["policy_hash"]
          }
        ]
      },

      "F3_COMMAND_STEEL_THREAD": {
        "type": "mixed",
        "steps": [
          {
            "n": 1,
            "from": "FastAPI",
            "to": "quoodle_agent_linux",
            "message_type": "COMMAND_DELIVERY",
            "rules": ["verify_sig", "schema_validate", "replay_check", "policy_check"]
          },
          {
            "n": 2,
            "from": "quoodle_agent_linux",
            "to": "FastAPI",
            "message_type": "COMMAND_ACK",
            "rules": ["idempotent", "retry_safe"]
          },
          {
            "n": 3,
            "from": "quoodle_agent_linux",
            "to": "quoodle_privileged_daemon",
            "local_call": "RequestSchema",
            "rules": ["monotonic_agent_sequence", "policy_hash_pinned", "allowlist_only"]
          },
          {
            "n": 4,
            "from": "quoodle_privileged_daemon",
            "to": "quoodle_agent_linux",
            "local_call": "ResponseSchema",
            "rules": ["signed_response", "typed_error"]
          },
          {
            "n": 5,
            "from": "quoodle_agent_linux",
            "to": "FastAPI",
            "message_type": "COMMAND_RESULT",
            "rules": ["idempotent", "retry_safe"]
          }
        ]
      },

      "F4_TELEMETRY": {
        "type": "async",
        "steps": [
          {
            "n": 1,
            "local": "quoodle_agent_linux",
            "action": "collect_telemetry",
            "rules": ["schema_valid", "no_secrets"]
          },
          {
            "n": 2,
            "from": "quoodle_agent_linux",
            "to": "FastAPI",
            "message_type": "TELEMETRY",
            "rules": ["idempotent", "retry_safe"]
          }
        ]
      }
    },

    "multi_run_validation": {
      "goal": "Prove deterministic, smooth flow under retries and duplicates without changing the top stack.",
      "runs_required": 5,
      "each_run_must_include": [
        "F1_WSS_AUTH",
        "F2_POLICY_UPDATE (or no-op if unchanged)",
        "F3_COMMAND_STEEL_THREAD",
        "F4_TELEMETRY"
      ],
      "fault_injections": [
        { "run": 2, "inject": "wss_disconnect_mid_flow", "expect": "reconnect + no duplicate terminal result" },
        { "run": 3, "inject": "duplicate_command_delivery", "expect": "idempotent ACK + RESULT" },
        { "run": 4, "inject": "replayed_nonce_or_message_id", "expect": "rejected + logged as replay" },
        { "run": 5, "inject": "policy_hash_mismatch", "expect": "local denial + typed error result" }
      ]
    },

    "observability": {
      "log_schema": {
        "required_fields": [
          "timestamp",
          "level",
          "service",
          "env",
          "trace_id",
          "message_id(optional)",
          "session_id(optional)",
          "device_id",
          "command_message_id(optional)",
          "request_id(optional)",
          "event_type",
          "stage",
          "sync_or_async",
          "latency_ms",
          "result",
          "error_code(optional)"
        ]
      },
      "trace_propagation": [
        "trace_id is generated at ingress (Mobile->Laravel) and propagated through dispatch, WSS messages, and local privileged calls where possible"
      ],
      "auditing": [
        "append-only audit entries for AUTH, POLICY_COMMIT, COMMAND_ACK, PRIVILEGED_EXEC, COMMAND_RESULT, TELEMETRY_ACCEPTED"
      ]
    },

    "future_linux_portability_guardrails": {
      "why_this_works_later": [
        "Top stack sees Linux agent as just another agent that speaks the same WSS contract",
        "Privileged boundary is swappable per OS as long as Request/Response schemas are preserved"
      ],
      "rules_to_keep_now": [
        "Do not add Windows-specific validation in FastAPI for agent_info fields",
        "Keep telemetry schema OS-neutral with optional platform-specific sections",
        "Keep policy bundle semantics identical across OS"
      ]
    }
  }
}

{
  "LinuxPrivilegedInterface": {
    "version": "1.1.0",
    "status": "canonical",
    "description": "Abstract capability contract for Linux unprivileged Agent ↔ root Privileged Executor.",
    "Compatibility": {
      "mirrors_windows_kernel_contract": true,
      "notes": [
        "Same signing and replay semantics as the Windows Agent ↔ KernelService contract.",
        "Transport is local-only (AF_UNIX) and not a network surface."
      ]
    },
    "Transport": {
      "socket_type": "AF_UNIX stream",
      "framing": "4-byte big-endian length prefix followed by UTF-8 JSON payload",
      "max_payload_bytes": 1048576,
      "peer_credentials": "SO_PEERCRED required; daemon may enforce allowed uid/gid"
    },
    "NormativeSecurityRules": {
      "Canonicalization": {
        "standard": "JCS (JSON Canonicalization Scheme - RFC 8785)",
        "constraints": [
          "UTF-8 encoding only",
          "Lexicographical key sorting",
          "No insignificant whitespace",
          "Floats prohibited; use integers or fixed-point strings",
          "Stable ISO8601 UTC timestamps (YYYY-MM-DDTHH:MM:SSZ)"
        ]
      },
      "SequenceContract": {
        "scope": "device_global",
        "persistence": "required (must persist across reboots/crashes)",
        "regression_policy": "STRICT_DENY (Daemon must drop and log replay attempt if sequence <= last_seen)"
      },
      "SignatureSchema": {
        "fields": {
          "alg": "string (default: Ed25519)",
          "kid": "string (Key Identifier)",
          "canon": "string (default: JCS-v1)",
          "signer": "string (agent | daemon)",
          "sig": "string (Base64 signature bytes)"
        }
      },
      "SignatureInput": {
        "request": "JCS canonical JSON of the request object with sig.sig omitted or set to empty string",
        "response": "JCS canonical JSON of the response object with sig.sig omitted or set to empty string"
      },
      "TimestampValidation": {
        "max_clock_skew_seconds": 120,
        "reject_if_older_than_seconds": 600
      },
      "Idempotency": {
        "request_id": "Required idempotency key. Duplicate request_id MUST return the original response payload.",
        "dedupe_window_seconds": 86400
      },
      "IdentityBinding": {
        "device_id_source": "Local peer identity (SO_PEERCRED + agent keypair).",
        "notes": [
          "device_id is not required in the request; identity is derived from the local authenticated peer."
        ]
      }
    },
    "RequestSchema": {
      "fields": {
        "request_id": "UUID",
        "timestamp": "ISO8601",
        "capability": "string (matches AllowedCapabilities)",
        "params": "object (validated per-capability)",
        "agent_sequence": "integer (strictly increasing)",
        "policy_hash": "sha256",
        "command_message_id": "UUID",
        "sig": "SignatureSchema"
      }
    },
    "ResponseSchema": {
      "fields": {
        "request_id": "UUID (matches request)",
        "status": "string (ok | failed | denied | error)",
        "exec_id": "UUID (daemon-side trace)",
        "timestamp": "ISO8601",
        "error": {
          "type": "string (ErrorTypeEnum)",
          "code": "integer",
          "message": "string (sanitized)"
        },
        "result": "object | null",
        "sig": "SignatureSchema"
      }
    },
    "AllowedCapabilities": {
      "CAP_LOCK_SESSION": {
        "required": true,
        "params": {},
        "result": { "session_count_locked": "integer" }
      },
      "CAP_REBOOT_SYSTEM": {
        "required": true,
        "params": { "delay_seconds": "integer" },
        "result": { "initiated": "boolean" }
      },
      "CAP_SHUTDOWN_SYSTEM": {
        "required": false,
        "params": { "delay_seconds": "integer", "force": "boolean" },
        "result": { "initiated": "boolean" }
      },
      "CAP_TERMINATE_PROCESS": {
        "required": false,
        "params": { "pid": "integer", "signal": "integer" },
        "result": { "killed": "boolean" }
      },
      "CAP_NETWORK_ISOLATION": {
        "required": false,
        "params": { "enabled": "boolean" },
        "result": { "current_state": "string" }
      },
      "CAP_ATTESTATION": {
        "required": false,
        "params": { "nonce": "string", "method": "string" },
        "result": { "quote": "string", "pcr_values": "object" }
      },
      "CAP_DISCOVERY": {
        "required": true,
        "description": "Returns supported capabilities and attestation methods.",
        "params": {},
        "result": {
          "supported_caps": ["string"],
          "attestation_methods": ["string"]
        }
      },
      "CAP_POLICY_SET": {
        "required": true,
        "description": "Internal-only: update the executor's active policy_hash.",
        "params": { "policy_hash": "sha256" },
        "result": { "applied": "boolean" }
      }
    },
    "CapabilityRules": {
      "internal_only_capabilities": ["CAP_POLICY_SET", "CAP_DISCOVERY"],
      "deny_if_not_supported": true
    },
    "MethodToCapabilityMap": {
      "description": "Abstract mapping of Control Plane methods to Executor capabilities.",
      "lock_screen": "CAP_LOCK_SESSION",
      "ping": "AGENT_LOCAL",
      "screenshot": "UNSUPPORTED",
      "collect_logs": "UNSUPPORTED",
      "update_agent": "AGENT_LOCAL_OTA",
      "rotate_keys": "AGENT_LOCAL",
      "reboot": "CAP_REBOOT_SYSTEM",
      "shutdown": "CAP_SHUTDOWN_SYSTEM",
      "quarantine": "CAP_NETWORK_ISOLATION",
      "attest": "CAP_ATTESTATION"
    },
    "MethodToCapabilityMapNotes": {
      "AGENT_LOCAL": "Handled entirely in the unprivileged agent; no privileged executor call.",
      "AGENT_LOCAL_OTA": "Handled by the OTA pipeline, not the privileged executor.",
      "UNSUPPORTED": "Agent must return COMMAND_RESULT with status=failed and error.type=ERR_CAPABILITY_NOT_SUPPORTED.",
      "future_methods": "Methods not in the current registry may be mapped for future use; unsupported methods must fail closed."
    },
    "ErrorTypeEnum": {
      "ERR_SCHEMA_INVALID": 1001,
      "ERR_SIG_INVALID": 1002,
      "ERR_REPLAY_DETECTED": 1003,
      "ERR_POLICY_HASH_MISMATCH": 1004,
      "ERR_CAPABILITY_NOT_SUPPORTED": 1005,
      "ERR_NOT_AUTHORIZED": 1006,
      "ERR_EXECUTION_FAILED": 2001,
      "ERR_TRANSIENT_BUSY": 3001
    }
  }
}

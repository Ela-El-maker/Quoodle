{
  "policy_version": "2026-01-21",
  "rules": {
    "commands": {
      "lock_screen": {
        "risk_level": "low",
        "requires_2fa": false,
        "allowed_roles": ["viewer", "operator", "admin"]
      },
      "reboot": {
        "risk_level": "medium",
        "requires_2fa": true,
        "allowed_roles": ["operator", "admin"]
      }
    },
    "rate_limits": {
      "per_device_per_minute": 30
    }
  }
}

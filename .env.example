# -----------------------------------------------------------------------------
# Quoodle centralized environment (single source of truth for Docker Compose)
# -----------------------------------------------------------------------------

# NOTE: Fill replace_me/change_me values before running docker compose

# Core app + dev user
APP_NAME=Quoodle Control Plane
APP_ENV=local
APP_KEY=base64:replace_me
APP_DEBUG=true
DEFAULT_USER_ROLE=operator
DEV_ADMIN_EMAIL=admin@quoodle.com
DEV_ADMIN_PASSWORD=change_me
DEV_ADMIN_NAME=Quoodle Admin

# Database + Redis
DB_CONNECTION=mysql
DB_HOST=quoodle-db
DB_PORT=3306
DB_DATABASE=secure_device
DB_USERNAME=quoodle
DB_PASSWORD=change_me
MYSQL_ROOT_PASSWORD=change_me
MYSQL_PASSWORD=change_me
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_URL=redis://redis:6379/0
REDIS_KEY_PREFIX=quoodle:

# Exposed ports
QUOODLE_DB_PORT=3308
QUOODLE_REDIS_PORT=6380
QUOODLE_CONTROL_PLANE_PORT=8088
QUOODLE_CONTROL_PLANE_UI_PORT=3000
QUOODLE_GATEWAY_PORT=8000
QUOODLE_GATEWAY_TLS_PORT=8443
QUOODLE_CONTROL_PLANE_HTTP_PORT_TLS=8080
QUOODLE_CONTROL_PLANE_HTTPS_PORT_TLS=8444

# Service URLs
CONTROL_PLANE_APP_URL=http://localhost:8088
CONTROL_PLANE_API_URL=http://control-plane:80/api
NEXT_PUBLIC_CONTROL_PLANE_BASE_URL=http://localhost:8088
NEXT_PUBLIC_CONTROL_PLANE_API_URL=http://localhost:8088/api
CONTROL_PLANE_UI_URL=http://localhost:3000
NEXT_PUBLIC_CONTROL_PLANE_UI_URL=http://localhost:3000
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
GOOGLE_OAUTH_REDIRECT_BASE_URL=
FASTAPI_BASE_URL=http://gateway:8000/api/v1
AI_SIDECAR_BASE_URL=http://ai-sidecar:8000
AI_SIDECAR_PORT=8010
LARAVEL_WEBHOOK_BASE=http://control-plane:80/api/v1/webhook
JWKS_URL=http://control-plane:80/.well-known/jwks.json
AUTH_COOKIE_SECURE=false

# Policy + signing keys
POLICY_HASH=sha256:replace_me
POLICY_VERSION=2026-01-21
ALLOW_DEVICE_REPAIR_WITH_HWID=false
LARAVEL_SERVICE_PRIVATE_KEY_B64=replace_me
LARAVEL_SERVICE_PUBKEY_B64=replace_me
FASTAPI_SERVICE_PRIVATE_KEY_B64=replace_me
FASTAPI_SERVICE_PUBLIC_KEY_B64=replace_me
ED25519_PRIVATE_KEY_B64=replace_me

# Gateway behavior
HEARTBEAT_INTERVAL_SECONDS=30
TELEMETRY_INTERVAL_SECONDS=60
CONTROLLER_ID=dev_controller_01
REQUIRE_ED25519=true
ALLOW_DEV_SIG_FALLBACK=false
REQUIRE_AGENT_SEQ=true
REQUIRE_LARAVEL_SIGNATURE=true
REQUIRE_FASTAPI_SIGNATURE=true
SIGN_LARAVEL_WEBHOOKS=true
ENABLE_TEST_ENDPOINTS=false

# AI (Phase 1 Device Health Copilot)
AI_GLOBAL_ENABLED=true
AI_DEVICE_COPILOT_ENABLED=true
AI_PROVIDER_QWEN_ENABLED=true
AI_DEFAULT_TENANT_ID=default
AI_SIDECAR_SERVICE_TOKEN=change_me
AI_SIDECAR_TIMEOUT_SECONDS=60
AI_REQUEST_TIMEOUT_SECONDS=15
AI_QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
AI_QWEN_API_KEY=replace_me
AI_QWEN_API_MODE=responses
AI_QWEN_MODEL=qwen3.6-plus
AI_QWEN_TIMEOUT_SECONDS=45
AI_QWEN_MAX_OUTPUT_TOKENS=1024
AI_PROMPT_TEMPLATES_DIR=prompts
AI_PROMPT_PROFILE=device_health
AI_PROMPT_VERSION=v1

# Passwordless auth
GOOGLE_CLIENT_ID=replace_me
GOOGLE_CLIENT_SECRET=replace_me
NEXT_PUBLIC_GOOGLE_CLIENT_ID=replace_me
GOOGLE_TOKEN_URL=https://oauth2.googleapis.com/token
GOOGLE_USERINFO_URL=https://openidconnect.googleapis.com/v1/userinfo
AUTH_OTP_DIGITS=6
AUTH_OTP_TTL_SECONDS=600
AUTH_OTP_RESEND_COOLDOWN_SECONDS=60
AUTH_OTP_MAX_ATTEMPTS=5
AUTH_OTP_REQUEST_IP_MAX_PER_MINUTE=20
AUTH_OTP_REQUEST_EMAIL_MAX_PER_MINUTE=6

# Mail (OTP delivery)
MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=replace_me
MAIL_PASSWORD=replace_me
MAIL_FROM_ADDRESS=replace_me
MAIL_FROM_NAME=Quoodle

# JWT (control plane)
JWT_ISSUER=secure-device-control-system
JWT_AUDIENCE=secure-device-clients
JWT_KID=K1
JWT_ALG=PS256
JWT_TTL=900
JWT_REFRESH_TTL=3600
JWT_PAIR_TOKEN_TTL=300
JWT_PRIVATE_KEY_PATH=storage/app/private/jwt_private.pem
JWT_PUBLIC_KEY_PATH=storage/app/private/jwt_public.pem

# Control-plane web boot behavior (local defaults)
RUN_MIGRATIONS_ON_BOOT=true
SEED_LOCAL_ADMIN_ON_BOOT=auto
CACHE_CONFIG_ON_BOOT=true
RUN_QUEUE_WORKER_IN_WEB=true
WAIT_FOR_DB_SECONDS=5
QUEUE_WORKER_SLEEP_SECONDS=1
QUEUE_WORKER_TRIES=3
QUEUE_WORKER_TIMEOUT_SECONDS=60
QUEUE_WORKER_QUEUES=fastapi,default

# Agent telemetry runtime (Windows agent process env)
AGENT_ENDPOINT=ws://localhost:8000/agent
AGENT_HEARTBEAT_INTERVAL_S=30
AGENT_TELEMETRY_INTERVAL_S=60
AGENT_TELEMETRY_HTTP_FALLBACK=1
# Optional overrides. If omitted, these are derived from AGENT_ENDPOINT.
AGENT_TELEMETRY_FALLBACK_URL=
AGENT_ARTIFACT_API_BASE_URL=
AGENT_TELEMETRY_QUEUE_DB_PATH=C:/ProgramData/Quoodle/telemetry_queue.db
AGENT_TELEMETRY_BATCH_SIZE=50
AGENT_TELEMETRY_MAX_QUEUE_ITEMS=5000
AGENT_TELEMETRY_RETRY_BACKOFF_S=5
AGENT_TELEMETRY_RETRY_BACKOFF_MAX_S=300

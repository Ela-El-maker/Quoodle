# -----------------------------------------------------------------------------
# Quoodle DigitalOcean mini droplet environment template
# -----------------------------------------------------------------------------
# Copy to .env.do-mini and replace all <...> placeholders.

# Core application
APP_NAME=Quoodle Control Plane
APP_ENV=production
APP_KEY=<base64-app-key>
APP_DEBUG=false
DEFAULT_USER_ROLE=operator

# Public URLs
# For first bring-up without TLS, use:
# - UI:  http://<droplet-ip>:3000
# - API: http://<droplet-ip>:8088
CONTROL_PLANE_APP_URL=http://<droplet-ip>:8088
CONTROL_PLANE_UI_URL=http://<droplet-ip>:3000
NEXT_PUBLIC_CONTROL_PLANE_BASE_URL=http://<droplet-ip>:8088
NEXT_PUBLIC_CONTROL_PLANE_API_URL=http://<droplet-ip>:8088/api
NEXT_PUBLIC_CONTROL_PLANE_UI_URL=http://<droplet-ip>:3000
GOOGLE_OAUTH_REDIRECT_URI=http://<droplet-ip>:3000/api/auth/google/callback
GOOGLE_OAUTH_REDIRECT_BASE_URL=
AUTH_COOKIE_SECURE=false

# Host binds / exposed ports
CONTROL_PLANE_BIND_IP=0.0.0.0
CONTROL_PLANE_UI_BIND_IP=0.0.0.0
GATEWAY_BIND_IP=0.0.0.0
AI_SIDECAR_BIND_IP=127.0.0.1
QUOODLE_CONTROL_PLANE_PORT=8088
QUOODLE_CONTROL_PLANE_UI_PORT=3000
QUOODLE_GATEWAY_PORT=8000
AI_SIDECAR_PORT=8010

# Local MySQL on the same droplet (containerized)
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=quoodle
DB_USERNAME=quoodle
DB_PASSWORD=<mysql-app-password>
MYSQL_ROOT_PASSWORD=<mysql-root-password>

# Local Redis on the same droplet (containerized)
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_URL=redis://redis:6379/0
REDIS_KEY_PREFIX=quoodle:

# Policy + crypto material
POLICY_HASH=<sha256-policy-hash>
POLICY_VERSION=<policy-version>
ALLOW_DEVICE_REPAIR_WITH_HWID=false
CONTROLLER_ID=<controller-id>

LARAVEL_SERVICE_PRIVATE_KEY_B64=<base64-ed25519-private>
LARAVEL_SERVICE_PUBKEY_B64=<base64-ed25519-public>
FASTAPI_SERVICE_PRIVATE_KEY_B64=<base64-ed25519-private>
FASTAPI_SERVICE_PUBLIC_KEY_B64=<base64-ed25519-public>
ED25519_PRIVATE_KEY_B64=<base64-ed25519-private>

# Gateway runtime
HEARTBEAT_INTERVAL_SECONDS=30
TELEMETRY_INTERVAL_SECONDS=60
REQUIRE_ED25519=true
ALLOW_DEV_SIG_FALLBACK=false
REQUIRE_AGENT_SEQ=true
REQUIRE_LARAVEL_SIGNATURE=true
REQUIRE_FASTAPI_SIGNATURE=true
SIGN_LARAVEL_WEBHOOKS=true
ENABLE_TEST_ENDPOINTS=false

# Inter-service URLs
FASTAPI_BASE_URL=http://gateway:8000/api/v1
LARAVEL_WEBHOOK_BASE=http://control-plane:80/api/v1/webhook
JWKS_URL=http://control-plane:80/.well-known/jwks.json
CONTROL_PLANE_API_BASE=http://control-plane:80
CONTROL_PLANE_API_URL=http://control-plane:80/api

# Auth + OTP
GOOGLE_CLIENT_ID=<google-client-id>
GOOGLE_CLIENT_SECRET=<google-client-secret>
NEXT_PUBLIC_GOOGLE_CLIENT_ID=<google-client-id>
GOOGLE_TOKEN_URL=https://oauth2.googleapis.com/token
GOOGLE_USERINFO_URL=https://openidconnect.googleapis.com/v1/userinfo
AUTH_OTP_DIGITS=6
AUTH_OTP_TTL_SECONDS=600
AUTH_OTP_RESEND_COOLDOWN_SECONDS=60
AUTH_OTP_MAX_ATTEMPTS=5
AUTH_OTP_REQUEST_IP_MAX_PER_MINUTE=20
AUTH_OTP_REQUEST_EMAIL_MAX_PER_MINUTE=6

# Mail (OTP and notifications)
MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=<smtp-host>
MAIL_PORT=587
MAIL_USERNAME=<smtp-user>
MAIL_PASSWORD=<smtp-password>
MAIL_FROM_ADDRESS=<from-email>
MAIL_FROM_NAME=Quoodle

# JWT paths (inside control-plane container)
JWT_ISSUER=secure-device-control-system
JWT_AUDIENCE=secure-device-clients
JWT_KID=K1
JWT_ALG=PS256
JWT_TTL=900
JWT_REFRESH_TTL=3600
JWT_PAIR_TOKEN_TTL=300
JWT_PRIVATE_KEY_PATH=storage/app/private/jwt_private.pem
JWT_PUBLIC_KEY_PATH=storage/app/private/jwt_public.pem

# Mini-droplet defaults
# - Web starts embedded worker for reduced footprint.
# - Scheduler remains separate.
RUN_MIGRATIONS_ON_BOOT=false
SEED_LOCAL_ADMIN_ON_BOOT=false
DEV_ADMIN_EMAIL=feloela444@gmail.com
DEV_ADMIN_NAME=Feloela Admin
CACHE_CONFIG_ON_BOOT=true
RUN_QUEUE_WORKER_IN_WEB=true
WAIT_FOR_DB_SECONDS=5
QUEUE_WORKER_SLEEP_SECONDS=2
QUEUE_WORKER_TRIES=3
QUEUE_WORKER_TIMEOUT_SECONDS=60
QUEUE_WORKER_QUEUES=fastapi,default

# AI sidecar (optional profile "ai")
AI_GLOBAL_ENABLED=false
AI_DEVICE_COPILOT_ENABLED=false
AI_PROVIDER_QWEN_ENABLED=false
AI_DEFAULT_TENANT_ID=default
AI_SIDECAR_BASE_URL=http://ai-sidecar:8000
AI_SIDECAR_SERVICE_TOKEN=<ai-sidecar-service-token>
AI_SIDECAR_TIMEOUT_SECONDS=15
AI_REQUEST_TIMEOUT_SECONDS=15
AI_QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
AI_QWEN_API_KEY=<qwen-api-key>
AI_QWEN_API_MODE=responses
AI_QWEN_MODEL=qwen3.6-plus
AI_QWEN_TIMEOUT_SECONDS=45
AI_QWEN_MAX_OUTPUT_TOKENS=1024
AI_PROMPT_TEMPLATES_DIR=prompts
AI_PROMPT_PROFILE=device_health
AI_PROMPT_VERSION=v1

# Optional Windows agent runtime env (if launching agent with env injection)
AGENT_ENDPOINT=ws://<droplet-ip>:8000/agent
# Optional overrides. If omitted, these are derived from AGENT_ENDPOINT.
AGENT_TELEMETRY_FALLBACK_URL=
AGENT_ARTIFACT_API_BASE_URL=

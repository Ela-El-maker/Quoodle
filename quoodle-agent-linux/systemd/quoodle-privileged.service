[Unit]
Description=Quoodle Linux Privileged Executor
After=network.target

[Service]
Type=simple
User=root
Group=quoodle-agent

Environment=QUOODLE_PRIV_SOCKET=/run/quoodle/privileged.sock

EnvironmentFile=-/etc/quoodle/secrets.env

# Create /run/quoodle safely
RuntimeDirectory=quoodle
RuntimeDirectoryMode=0750
StateDirectory=quoodle
StateDirectoryMode=0750

ExecStart=/opt/quoodle-agent/bin/quoodle-privileged-daemon
Restart=always
RestartSec=2

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/run/quoodle /var/lib/quoodle

[Install]
WantedBy=multi-user.target

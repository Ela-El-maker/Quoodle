[Unit]
Description=Quoodle Linux Agent
After=network.target quoodle-privileged.service
Wants=quoodle-privileged.service

[Service]
Type=simple
User=quoodle-agent
Group=quoodle-agent
WorkingDirectory=/opt/quoodle-agent

Environment=QUOODLE_WS_URL=ws://localhost:8000/agent
Environment=QUOODLE_PRIV_SOCKET=/run/quoodle/privileged.sock
Environment=QUOODLE_AGENT_STATE_DIR=/var/lib/quoodle-agent/state
EnvironmentFile=-/etc/quoodle/secrets.env

ExecStart=/opt/quoodle-agent/bin/quoodle-agent-linux
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target

	cd /home/ela/Work-Force/Quoodle/quoodle-agent-linux/build-audit && $(CMAKE_COMMAND) -S$(CMAKE_SOURCE_DIR) -B$(CMAKE_BINARY_DIR) --check-build-system CMakeFiles/Makefile.cmake 0
